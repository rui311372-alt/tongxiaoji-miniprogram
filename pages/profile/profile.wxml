<campus-header school-id="{{school.id}}" disabled="{{saving || calendarBusy || navigating}}" bind:schoolchange="onSchoolChanged" />
<view class="page profile-page">
  <view class="profile-summary">
    <image class="profile-portrait" src="{{profileInfo.avatar || '/assets/icon.png'}}" mode="aspectFill" />
    <view class="profile-summary-copy"><view class="profile-summary-name">{{profileInfo.nickname}}</view><view>{{school.name}} · {{profileInfo.major}}</view><text class="pill">{{profileInfo.demo_verified ? '已完成演示认证' : '尚未完成演示认证'}}</text></view>
    <button class="edit-profile" bindtap="toggleEditor" disabled="{{saving}}">{{editing ? '收起' : '编辑资料'}}</button>
  </view>
  <view wx:if="{{loadError}}" class="error-card">{{loadError}}<button bindtap="reloadProfile">重新读取资料</button></view>
  <view wx:if="{{editing}}" class="editor-card">
    <view class="avatar-row"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{saving || !canSave}}"><image class="avatar-image" src="{{draftAvatar || '/assets/icon.png'}}" mode="aspectFill" /><text class="avatar-label">更换头像</text></button><view class="avatar-copy"><view class="avatar-name">{{nickname || '同校同学'}}</view><view class="muted">选择后点击下方“保存资料”生效</view><button wx:if="{{draftAvatar}}" class="remove-avatar" bindtap="removeAvatar" disabled="{{saving}}">移除头像</button></view></view>
    <view class="field"><text class="field-label">当前学校</text><view>{{school.name}}</view></view>
    <view class="field"><text class="field-label">昵称</text><input class="field-input" value="{{nickname}}" maxlength="20" placeholder="填写昵称（最多 20 字）" bindinput="changeNickname" disabled="{{saving || !canSave}}" /></view>
    <view class="field"><text class="field-label">专业</text><picker class="major-picker" range="{{majors}}" value="{{majorIndex}}" bindchange="changeMajor" disabled="{{saving || !canSave}}"><view class="picker-value">{{majors[majorIndex]}}<text class="picker-arrow">选择 ›</text></view></picker></view>
    <checkbox-group bindchange="changeVerification"><label class="verification-label"><checkbox value="verified" checked="{{demoVerified}}" color="#2c624c" disabled="{{saving || !canSave}}" /><view>完成校园身份演示认证<text>仅演示流程，不提交真实学号或证件。</text></view></label></checkbox-group>
    <button class="save-button" bindtap="save" loading="{{saving}}" disabled="{{saving || !canSave}}">{{saving ? '正在保存' : '保存资料'}}</button><view class="save-status">{{saveHint}}</view>
  </view>
  <button class="credit-shortcut" data-tab="credit" bindtap="changeTab" disabled="{{saving || calendarBusy || navigating}}"><view class="credit-shield">✓</view><view class="credit-shortcut-copy"><view>校园信用 <text>{{credit ? credit.score : '—'}}</text></view><view class="muted">{{experienceError ? '信用记录读取失败，请重试' : credit ? credit.level : '读取本机信用记录'}} · 查看规则与每次变动</view></view><text class="chevron">›</text></button>
  <view class="profile-stats">
    <button class="stat-button" data-tab="posts" bindtap="changeTab" disabled="{{saving || calendarBusy || navigating}}"><text class="stat-icon">↑</text><text class="stat-number">{{dataError ? '—' : counts.posts}}</text><text>本校发布</text></button>
    <button class="stat-button" data-tab="saved" bindtap="changeTab" disabled="{{saving || calendarBusy || navigating}}"><text class="stat-icon">♡</text><text class="stat-number">{{favoritesError ? '—' : counts.saved}}</text><text>本校收藏</text></button>
    <button class="stat-button" data-tab="orders" bindtap="changeTab" disabled="{{saving || calendarBusy || navigating}}"><text class="stat-icon">◷</text><text class="stat-number">{{experienceError ? '—' : counts.pending}}</text><text>待见面预约</text></button>
    <button class="stat-button" data-tab="history" bindtap="changeTab" disabled="{{saving || calendarBusy || navigating}}"><text class="stat-icon">↶</text><text class="stat-number">{{experienceError ? '—' : counts.history}}</text><text>本校足迹</text></button>
  </view>
  <view class="local-note">认证流程仅作展示，不核验真实在校身份。请勿填写真实学号、证件或密码。</view>
  <scroll-view scroll-x="{{true}}" class="mine-tabs" enhanced="{{true}}" show-scrollbar="{{false}}"><view class="mine-tabs-inner"><button wx:for="{{tabs}}" wx:key="id" class="mine-tab {{mineTab === item.id ? 'active' : ''}}" data-tab="{{item.id}}" bindtap="changeTab" disabled="{{saving}}">{{item.label}}</button></view></scroll-view>
  <view wx:if="{{dataError || favoritesError || experienceError}}" class="error-card"><view wx:if="{{dataError}}">{{dataError}}</view><view wx:if="{{favoritesError}}">{{favoritesError}}</view><view wx:if="{{experienceError}}">{{experienceError}}</view><button bindtap="refreshDashboard" disabled="{{saving}}">重新读取本机记录</button></view>

  <view wx:if="{{mineTab === 'orders'}}">
    <view class="order-area-tabs"><button class="order-area-tab {{orderArea === 'appointments' ? 'active' : ''}}" data-area="appointments" bindtap="changeOrderArea" disabled="{{saving || calendarBusy || navigating}}">见面预约 <text>{{experienceError ? '—' : orders.length}}</text></button><button class="order-area-tab {{orderArea === 'auctions' ? 'active' : ''}}" data-area="auctions" bindtap="changeOrderArea" disabled="{{saving || calendarBusy || navigating}}">我参与的拍卖 <text>{{auctionError ? '—' : auctionParticipation.length}}</text></button></view>
    <block wx:if="{{orderArea === 'appointments'}}">
    <view class="list-heading"><view class="section-title">线下见面，记录在这里</view><text class="meta">模拟订单 · 不扣款</text></view>
    <scroll-view scroll-x="{{true}}" class="chips-scroll" show-scrollbar="{{false}}"><view class="chips"><button wx:for="{{statuses}}" wx:key="id" class="chip {{orderStatus === item.id ? 'active' : ''}}" data-status="{{item.id}}" bindtap="changeOrderStatus" disabled="{{saving || calendarBusy || navigating}}">{{item.label}}</button></view></scroll-view>
    <view wx:if="{{!visibleOrders.length && !experienceError}}" class="empty"><view>{{orderStatus === 'all' ? '还没有预约' : '当前分类下没有订单'}}</view><view>去二手集市挑选一件感兴趣的物品，聊清楚再约见面。</view><button wx:if="{{orderStatus === 'all'}}" class="empty-action" bindtap="browseMarket">去逛二手集市</button></view>
    <view wx:for="{{visibleOrders}}" wx:key="id" id="order-{{item.id}}" class="order-card {{focusedOrderId === item.id ? 'focused' : ''}}">
      <view class="row-between"><text class="status-pill status-{{item.status}}">{{item.statusLabel}}</text><text class="meta">{{school.name}} · 第 {{item.attempt}} 次预约</text></view>
      <view class="order-product" data-id="{{item.id}}" bindtap="openOrder"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" /><view wx:else class="item-image-fallback">物</view><view class="item-copy"><view class="item-title">{{item.title}}</view><text class="price">¥{{item.priceLabel}}</text><text class="view-detail">查看商品 ›</text></view></view>
      <view class="order-line"><text class="line-icon">⌖</text><text>{{item.place}}</text></view><view class="order-line"><text class="line-icon">◷</text><text>{{item.meetingLabel}}</text></view><view wx:if="{{item.note}}" class="order-note">备注：{{item.note}}</view>
      <block wx:if="{{item.status === 'reserved'}}"><view class="appointment-note {{item.overdue ? 'overdue' : ''}}">{{item.cancelNote}}</view><view class="order-tools"><button class="text-button" data-id="{{item.id}}" bindtap="calendar" disabled="{{calendarBusy || saving || navigating}}">{{calendarBusy ? '正在处理日历…' : '分享日历文件'}}</button><button class="text-button" data-id="{{item.id}}" bindtap="copyAppointment">复制预约</button><button class="text-button danger" data-id="{{item.id}}" data-action="no_show" bindtap="changeOrder" disabled="{{saving || calendarBusy || navigating}}">模拟本人爽约</button></view><view class="order-actions"><button class="outline-button" data-id="{{item.id}}" data-action="cancelled" bindtap="changeOrder" disabled="{{saving || calendarBusy || navigating}}">取消预约</button><button class="primary-button" data-id="{{item.id}}" data-action="completed" bindtap="changeOrder" disabled="{{saving || calendarBusy || navigating}}">模拟确认完成</button></view></block>
      <block wx:else><button class="credit-record-link" data-tab="credit" bindtap="changeTab">{{item.status === 'completed' ? '完成记录' : item.status === 'no_show' ? '爽约记录' : '取消记录'}} · 查看信用变动 ›</button><button wx:if="{{item.status === 'cancelled'}}" class="rebook-button" data-id="{{item.id}}" bindtap="openOrder">查看商品并重新预约</button></block>
    </view>
    </block>
    <block wx:else>
      <view class="list-heading"><view class="section-title">我参与的拍卖</view><text class="meta">本校 {{auctionError ? '—' : auctionParticipation.length}} 场 · 出价不等于预约</text></view>
      <view wx:if="{{auctionError}}" class="error-card">{{auctionError}}<button bindtap="refreshAuctionParticipation">重新读取拍卖记录</button></view>
      <scroll-view scroll-x="{{true}}" class="chips-scroll" show-scrollbar="{{false}}"><view class="chips"><button wx:for="{{auctionFilters}}" wx:key="id" class="chip {{auctionStatus === item.id ? 'active' : ''}}" data-status="{{item.id}}" bindtap="changeAuctionStatus" disabled="{{saving || calendarBusy || navigating}}">{{item.label}}</button></view></scroll-view>
      <view wx:if="{{!visibleAuctions.length && !auctionError}}" class="empty"><view>{{auctionParticipation.length ? '当前筛选下暂无参与记录' : '还没有参与本校拍卖'}}</view><view>{{auctionParticipation.length ? '试试查看其他进度，已中拍记录也可查看预约状态。' : '浏览或收藏不算参与；实际出价后，进度会显示在这里。'}}</view><button wx:if="{{!auctionParticipation.length}}" class="empty-action" bindtap="browseAuctions">去看看校园拍卖</button><button wx:else class="empty-action" data-status="all" bindtap="changeAuctionStatus">查看全部参与记录</button></view>
      <view wx:for="{{visibleAuctions}}" wx:key="id" class="participation-card">
        <view class="row-between participation-top"><text class="status-pill participation-{{item.status}}">{{item.statusLabel}}</text><text class="auction-time {{item.ended ? '' : 'is-active'}}">{{item.timeHint}}</text></view>
        <view class="participation-product" data-id="{{item.id}}" bindtap="openAuction"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" /><view wx:else class="item-image-fallback">物</view><view class="item-copy"><view class="item-title">{{item.title}}</view><view class="meta">截止 {{item.endLabel}}</view></view></view>
        <view class="participation-prices"><view><text>{{item.ended ? '最终出价' : '当前出价'}}</text><text class="price">¥{{item.priceLabel}}</text></view><view><text>我的最高出价</text><text class="my-bid-price">¥{{item.myPriceLabel}}</text></view></view>
        <view class="participation-meta">出价 {{item.my_bid_count}} 次 · 最近出价 {{item.lastBidLabel}}</view><view class="participation-note">{{item.note}}</view><view class="participation-actions"><button wx:if="{{item.action !== 'auction'}}" class="text-button" data-id="{{item.id}}" bindtap="openAuction" disabled="{{saving || calendarBusy || navigating}}">拍卖详情</button><button class="participation-action" data-id="{{item.id}}" bindtap="auctionAction" disabled="{{saving || calendarBusy || navigating}}">{{navigating && navigationId === item.id ? '打开中…' : item.actionLabel + ' ›'}}</button></view>
      </view>
    </block>
  </view>

  <view wx:elif="{{mineTab === 'posts'}}"><view class="list-heading row-between"><view class="section-title">我的本校发布</view><button class="text-button" bindtap="publishMore">继续分享 ›</button></view><view wx:if="{{!posts.length && !dataError}}" class="empty">还没有在当前学校分享资料、发布闲置或求助。<button class="empty-action" bindtap="publishMore">发布第一条内容</button></view><view wx:for="{{posts}}" wx:key="key" class="record-card" data-key="{{item.key}}" bindtap="openPublished"><image wx:if="{{item.image}}" class="record-photo" src="{{item.image}}" mode="aspectFill" /><view wx:else class="record-symbol">{{item.kind === 'resource' ? '书' : item.kind === 'product' ? '物' : '求'}}</view><view class="item-copy"><view class="record-meta"><text class="pill">{{item.label}}</text><text class="meta">{{item.statusLabel}}</text></view><view class="item-title">{{item.title}}</view><view class="muted line-clamp">{{item.subtitle}}</view><view class="meta">{{item.timeLabel}}</view></view><text class="chevron">›</text></view></view>

  <view wx:elif="{{mineTab === 'saved'}}"><view class="list-heading"><view class="section-title">本校收藏</view><text class="meta">切换学校查看其他收藏</text></view><view class="chips"><button wx:for="{{favoriteKinds}}" wx:key="id" class="chip {{favoriteKind === item.id ? 'active' : ''}}" data-kind="{{item.id}}" bindtap="changeFavoriteKind">{{item.label}} {{item.count}}</button></view><view wx:if="{{!visibleFavorites.length && !favoritesError}}" class="empty">点亮资料或商品旁的爱心，就能在这里找到。</view><view wx:for="{{visibleFavorites}}" wx:key="key" class="record-card" data-section="{{item.section}}" data-id="{{item.id}}" bindtap="openFavorite"><image wx:if="{{item.image}}" class="record-photo" src="{{item.image}}" mode="aspectFill" /><view wx:else class="record-symbol">{{item.section === 'resources' ? '书' : '物'}}</view><view class="item-copy"><text class="pill">{{item.label}}</text><view class="item-title">{{item.title}}</view><view class="muted">{{item.subtitle}}</view></view><button class="favorite-remove" data-section="{{item.section}}" data-id="{{item.id}}" catchtap="removeFavorite">取消收藏</button></view></view>

  <view wx:elif="{{mineTab === 'history'}}"><view class="list-heading row-between"><view><view class="section-title">最近看过</view><view class="meta">仅保存在当前设备 · 本校 {{trails.length}} 条</view></view><button wx:if="{{trails.length}}" class="text-button" bindtap="clearHistory" disabled="{{saving}}">清空本校足迹</button></view><view wx:if="{{!trails.length && !experienceError}}" class="empty">看过的本校资料与闲置会出现在这里，方便回来接着看。</view><view wx:for="{{trails}}" wx:key="key" class="record-card" data-section="{{item.section}}" data-id="{{item.id}}" bindtap="openFavorite"><image wx:if="{{item.image}}" class="record-photo" src="{{item.image}}" mode="aspectFill" /><view wx:else class="record-symbol">{{item.section === 'resources' ? '书' : '物'}}</view><view class="item-copy"><text class="trail-kind">{{item.label}}</text><view class="item-title">{{item.title}}</view><view class="meta">{{item.timeLabel}}</view></view><text class="chevron">›</text></view></view>

  <view wx:elif="{{mineTab === 'credit' && credit}}" class="credit-panel">
    <view class="credit-hero"><view><view class="section-kicker">CAMPUS CREDIT · 演示</view><view class="credit-title">我的校园信用</view><view class="credit-level">{{credit.level}}</view></view><view class="credit-orb"><text class="orb-mark">✓</text><text class="credit-score">{{credit.score}}</text><text>满分 120</text></view></view><view class="credit-track"><view style="width:{{creditWidth}}%" /></view>
    <view class="credit-metrics"><view><text>{{creditCounts.completed}}</text><text>本校完成记录</text></view><view><text>{{creditCounts.late_cancel}}</text><text>本校临近取消</text></view><view><text>{{creditCounts.no_show}}</text><text>本校爽约记录</text></view></view>
    <view class="credit-allowance {{credit.score < 80 ? 'limited' : ''}}">{{credit.limit ? '当前最多同时保留 ' + credit.limit + ' 个待见面预约。' : '当前暂停新预约，已有订单仍可查看和处理。'}}<text>待见面预约 {{credit.activeCount}} / {{credit.limit}}</text></view><view class="local-note">初始 100 分。这是当前本机账号的课堂演示信用，不等于真实学籍核验或交易担保。资料评分不直接影响交易信用；切换学校或改昵称不会重置信用。</view>
    <view class="credit-block"><view class="block-title">信用规则与预约限制</view><view wx:for="{{ruleRows}}" wx:key="id" class="rule-row"><view><view>{{item.label}}</view><text class="meta">{{item.note}}</text></view><text class="rule-delta {{item.delta < 0 ? 'negative' : ''}}">{{item.delta > 0 ? '+' + item.delta : item.delta}}</text></view><view class="local-note">80 分及以上：最多 3 个待见面预约；60—79 分：最多 1 个；低于 60 分：暂停新预约。每次计分在 0—120 分内生效。</view></view>
    <view class="credit-block"><view class="block-title">试算一次信用变化</view><picker range="{{ruleLabels}}" value="{{simulationIndex}}" bindchange="changeSimulation"><view class="simulation-select">{{ruleLabels[simulationIndex]}}<text>选择情境 ›</text></view></picker><view class="simulation-result"><view>当前 <text>{{credit.score}}</text></view><text>→</text><view>试算 <text>{{projectedScore}}</text></view></view><view class="meta">仅演示计算，不写入账号。试算后预约上限：{{projectedLimit}} 个。</view></view>
    <view class="credit-block"><view class="block-title">本校信用变动记录</view><view wx:if="{{!ledger.length}}" class="empty ledger-empty">还没有本校信用变动。从认真对待第一次预约开始。</view><view wx:for="{{ledger}}" wx:key="key" class="ledger-row"><text class="ledger-delta {{item.delta < 0 ? 'negative' : ''}}">{{item.deltaLabel}}</text><view><view class="ledger-reason">{{item.reason}}</view><view class="muted">{{item.title}} · 第 {{item.attempt}} 次预约</view><view class="meta">{{item.timeLabel}} · {{item.score_before}} → {{item.score_after}} 分{{item.boundary ? '（已达分数边界）' : ''}}</view></view></view><view class="local-note">订单操作与信用变动一起保存；重复点击不会重复计分。记录仅属于当前设备的本人账号。</view></view>
  </view>
  <view class="mine-footer"><button class="text-button" bindtap="about">关于课堂体验与图片来源</button><button class="text-button" bindtap="returnHome" disabled="{{saving}}">回到发现首页</button></view>
</view>
<campus-nav active="mine" disabled="{{saving || calendarBusy || navigating}}" bind:select="onMainNav" />
