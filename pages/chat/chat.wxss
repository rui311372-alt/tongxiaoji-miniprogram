page{height:100%;overflow:hidden}.chat-page{height:100%;display:flex;flex-direction:column;overflow:hidden}.chat-title{padding:16rpx 28rpx 14rpx;background:#fffefa;border-bottom:1rpx solid #e8ebdf;color:#839077;font-size:21rpx;line-height:1.6;flex-shrink:0}.chat-title-main{color:#304a38;font-size:27rpx;font-weight:600}.product-banner{display:flex;gap:18rpx;align-items:center;background:#fffefa;padding:20rpx 28rpx;border-bottom:1rpx solid #e5e8db;margin:0;border-radius:0;width:100%;text-align:left;line-height:1.5;color:#253d32;flex-shrink:0}.product-mark{width:82rpx;height:82rpx;line-height:82rpx;background:#e4ebd8;color:#5f7b53;border-radius:15rpx;text-align:center;font-size:30rpx;font-weight:700;flex-shrink:0}.product-summary{flex:1;min-width:0}.product-title{font-size:27rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.product-price{font-size:23rpx;color:#a8643d;margin-top:8rpx}.auction-caption{font-size:20rpx;color:#8a8f78;margin-top:6rpx}.product-arrow{color:#89977f;font-size:35rpx}.demo-note{font-size:21rpx;text-align:center;color:#7c8875;line-height:1.6;padding:14rpx 20rpx;flex-shrink:0}.messages{flex:1;min-height:0;height:0}.message-row{display:flex;margin:22rpx 24rpx;gap:13rpx;align-items:flex-start}.message-row.mine{flex-direction:row-reverse}.message-avatar{width:51rpx;height:51rpx;border-radius:17rpx;background:#e0e8d4;line-height:51rpx;text-align:center;color:#687d58;font-size:22rpx;flex-shrink:0}.mine .message-avatar{background:#d6e5d4;color:#3e694d}.message-stack{max-width:calc(100% - 70rpx);min-width:0}.sender{font-size:20rpx;color:#85907d;margin-bottom:9rpx}.mine .sender,.mine .message-time{text-align:right}.message-content{padding:19rpx 22rpx;border:1rpx solid #e0e6d5;background:#fffefa;font-size:26rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word;border-radius:20rpx}.mine .message-content{background:#3a6b54;border-color:#3a6b54;color:#fff}.message-time{color:#929b87;font-size:18rpx;margin-top:8rpx}.bottom-space{height:18rpx}.quick-questions{display:flex;gap:10rpx;overflow-x:auto;flex-shrink:0;padding:15rpx 22rpx 4rpx;background:#fffefa}.quick-questions button{width:auto;min-width:0;flex-shrink:0;margin:0;background:#f2f5e9;border:1rpx solid #dce5d2;border-radius:14rpx;color:#607b53;font-size:22rpx;line-height:1.5;padding:13rpx 15rpx}.composer{display:flex;gap:14rpx;padding:18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));background:#fffefa;border-top:1rpx solid #e2e7d8;align-items:center;flex-shrink:0}.composer input{flex:1;min-width:0;border:1rpx solid #dfe6d7;padding:17rpx;height:81rpx;background:#f7f7f0;border-radius:16rpx;font-size:26rpx}.composer button{width:auto;min-width:0;flex:0 0 auto;background:#33654f;color:white;font-size:25rpx;line-height:1.4;margin:0;padding:23rpx 26rpx;border-radius:16rpx}.composer button[disabled]{background:#a4b4a0;color:white}.keyboard-open .chat-title,.keyboard-open .demo-note,.keyboard-open .quick-questions{display:none}.keyboard-open .product-banner{padding-top:12rpx;padding-bottom:12rpx}.keyboard-open .product-mark{height:62rpx;width:62rpx;line-height:62rpx}.keyboard-open .composer{padding-bottom:18rpx}.error{color:#a13e27;line-height:1.7;font-size:24rpx;padding:14rpx 26rpx;background:#fff5e9;flex-shrink:0}.empty button{margin-top:32rpx;color:white;background:#33654f}
