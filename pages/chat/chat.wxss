page { height: 100%; overflow: hidden; }
.chat-page { height: 100%; display: flex; flex-direction: column; overflow: hidden; background: #f8f7f2; }
.chat-title { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 14rpx 24rpx; border-bottom: 1rpx solid #e6e9df; background: #fffefa; color: #6e7d6e; font-size: 24rpx; line-height: 1.6; flex-shrink: 0; }
.chat-title-copy { flex: 1; min-width: 0; }
.chat-title-main { color: #2d4d3a; font-size: 30rpx; font-weight: 650; line-height: 1.5; margin-bottom: 3rpx; }
.chat-page .clear-records { flex: 0 0 auto; width: auto; min-width: 112rpx; max-width: none; min-height: 72rpx; margin: 0; padding: 17rpx 18rpx; line-height: 1.5; font-size: 24rpx; color: #98614f; background: #f8eee7; border-radius: 18rpx; }
.chat-page .clear-records[disabled] { color: #899280; background: #f1f3ec; }
.chat-page .product-banner { display: flex; align-items: center; gap: 18rpx; width: calc(100% - 48rpx); min-width: 0; max-width: none; margin: 18rpx 24rpx 0; padding: 20rpx; border: 1rpx solid #e0e6d8; border-radius: 24rpx; background: #fffefa; text-align: left; line-height: 1.5; color: #253d32; flex-shrink: 0; }
.product-mark { width: 88rpx; height: 88rpx; line-height: 88rpx; background: #e8eedf; color: #5b7754; border: 1rpx solid #e2e8db; border-radius: 18rpx; text-align: center; font-size: 30rpx; font-weight: 700; flex-shrink: 0; }
.product-summary { flex: 1; min-width: 0; }
.product-title { font-size: 29rpx; font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.product-price { font-size: 25rpx; color: #9a6241; margin-top: 7rpx; word-break: break-all; }
.auction-caption { font-size: 23rpx; color: #74806d; margin-top: 6rpx; }
.product-arrow { color: #7b8d74; font-size: 35rpx; flex: none; }
.demo-note { padding: 16rpx 22rpx; font-size: 23rpx; text-align: center; color: #6d7d6c; line-height: 1.65; flex-shrink: 0; }
.messages { flex: 1; min-height: 0; height: 0; }
.message-row { display: flex; margin: 24rpx; gap: 14rpx; align-items: flex-start; }
.message-row.mine { flex-direction: row-reverse; }
.message-avatar { width: 54rpx; height: 54rpx; border-radius: 18rpx; background: #e3eadb; line-height: 54rpx; text-align: center; color: #59724f; font-size: 24rpx; font-weight: 550; flex-shrink: 0; }
.mine .message-avatar { background: #dce9db; color: #386248; }
.message-stack { max-width: calc(100% - 70rpx); min-width: 0; }
.sender { font-size: 23rpx; color: #6d7d67; margin-bottom: 9rpx; line-height: 1.5; }
.mine .sender, .mine .message-time { text-align: right; }
.message-content { padding: 20rpx 23rpx; border: 1rpx solid #dfe5d8; border-radius: 24rpx; background: #fffefa; color: #2a4333; font-size: 29rpx; line-height: 1.75; white-space: pre-wrap; word-break: break-all; }
.mine .message-content { background: #35644d; border-color: #35644d; color: #fffefa; }
.message-time { color: #74816d; font-size: 22rpx; line-height: 1.5; margin-top: 8rpx; font-variant-numeric: tabular-nums; }
.bottom-space { height: 20rpx; }
.chat-empty { padding: 70rpx 28rpx; text-align: center; color: #6e7d69; font-size: 26rpx; line-height: 1.8; }
.chat-empty-title { color: #3c5d43; font-size: 32rpx; font-weight: 650; margin-bottom: 12rpx; }
.quick-questions { display: flex; gap: 12rpx; overflow-x: auto; flex-shrink: 0; padding: 16rpx 22rpx 12rpx; background: #fffefa; }
.quick-questions button { width: auto; min-width: 0; min-height: 72rpx; flex-shrink: 0; margin: 0; padding: 17rpx 20rpx; border: 1rpx solid #dde6d4; border-radius: 18rpx; background: #f1f5ea; color: #4e704c; font-size: 24rpx; line-height: 1.5; }
.composer { display: flex; gap: 14rpx; padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e2e7db; background: #fffefa; align-items: center; flex-shrink: 0; }
.composer input { flex: 1; min-width: 0; border: 1rpx solid #dfe5d7; padding: 18rpx 20rpx; height: 88rpx; background: #f7f8f2; border-radius: 22rpx; color: #294735; font-size: 29rpx; }
.composer input:focus { border-color: #90aa8d; background: #fffefa; }
.composer button { display: flex; align-items: center; justify-content: center; width: auto; min-width: 112rpx; min-height: 88rpx; flex: 0 0 auto; margin: 0; padding: 22rpx 26rpx; border-radius: 22rpx; background: #315f49; color: #fffefa; font-size: 28rpx; line-height: 1.5; }
.composer button[disabled] { background: #a4b4a0; color: #fff; }
.keyboard-open .chat-title, .keyboard-open .demo-note, .keyboard-open .quick-questions { display: none; }
.chat-page.keyboard-open .product-banner { margin-top: 12rpx; padding: 12rpx 18rpx; }
.keyboard-open .product-mark { height: 62rpx; width: 62rpx; line-height: 62rpx; border-radius: 14rpx; }
.keyboard-open .composer { padding-bottom: 18rpx; }
.error { padding: 14rpx 26rpx; background: #fff1e8; color: #9e432d; font-size: 26rpx; line-height: 1.7; flex-shrink: 0; }
.empty button { min-height: 88rpx; margin-top: 32rpx; color: #fffefa; background: #33654f; border-radius: 24rpx; }
