<view class="chat-page {{keyboardOpen?'keyboard-open':''}}" style="{{viewportHeight?'height:'+(viewportHeight-keyboardHeight)+'px;':''}}">
  <block wx:if="{{thread}}">
    <view class="chat-title"><view class="chat-title-copy"><view class="chat-title-main">商品咨询</view><view>卖家回复为预设演示内容</view></view><button hover-class="ui-press" class="clear-records" bindtap="clearRecords" disabled="{{busy || sending || !messages.length}}" hover-start-time="0" hover-stay-time="140">清空记录</button></view>
    <button hover-class="ui-press" class="product-banner" bindtap="openProduct" aria-label="查看商品详情" hover-start-time="0" hover-stay-time="140"><image wx:if="{{photo}}" class="product-mark" src="{{photo}}" mode="aspectFill" binderror="photoError"/><view wx:else class="product-mark">物</view><view class="product-summary"><view class="product-title">{{thread.product.title}}</view><view class="product-price">{{thread.product.sale_mode==='auction'?'起拍 ':''}}¥{{productPrice}} · {{thread.product.condition}}</view><view wx:if="{{thread.product.sale_mode==='auction'}}" class="auction-caption">当前出价与截止状态请以详情为准</view></view><text class="product-arrow">›</text></button>
    <view class="demo-note"><view>本机模拟会话 · 不联系真实卖家 · 不处理付款</view><view>{{isMine?'自己发布的物品 · 历史会话仅供查看':'最近 100 条消息'}} · 长按消息可删除</view></view>
    <scroll-view class="messages" scroll-y scroll-into-view="{{anchor}}" scroll-with-animation>
      <view wx:if="{{!messages.length}}" class="chat-empty"><view class="chat-empty-title">暂无聊天记录</view><view>{{isMine?'这段历史会话已清空。':'发送消息，开始新的对话。'}}</view></view>
      <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="message-row {{item.role==='me'?'mine':''}}"><view class="message-avatar">{{item.role==='me'?'我':'同'}}</view><view class="message-stack"><view class="sender">{{item.role==='me'?'我':'模拟卖家 · 自动回复'}}</view><view class="message-content" data-id="{{item.id}}" bindlongpress="deleteMessage">{{item.text}}</view><view class="message-time">{{item.time}}</view></view></view><view class="bottom-space"></view>
    </scroll-view>
    <view wx:if="{{error || actionError}}" class="error">{{actionError || error}}</view>
    <view wx:if="{{!isMine}}" class="quick-questions"><button hover-class="ui-press" wx:for="{{questions}}" wx:key="label" data-question="{{item.text}}" bindtap="quickQuestion" disabled="{{sending || busy}}" hover-start-time="0" hover-stay-time="140">{{item.label}}</button></view>
    <view wx:if="{{!isMine}}" class="composer"><input value="{{draft}}" maxlength="500" placeholder="输入想问的问题…" disabled="{{sending || busy}}" bindinput="input" bindconfirm="send" bindfocus="focusInput" bindblur="blurInput" bindkeyboardheightchange="onKeyboardHeightChange" focus="{{inputFocused}}" confirm-type="send" adjust-position="{{false}}" hold-keyboard="{{true}}"/><button hover-class="ui-press" bindtap="send" loading="{{sending}}" disabled="{{sending||busy||!canSend}}" hover-start-time="0" hover-stay-time="140">发送</button></view>
  </block>
  <view wx:else class="empty">{{error||'正在读取会话…'}}<button hover-class="ui-press" bindtap="goBack" hover-start-time="0" hover-stay-time="140">返回消息列表</button></view>
</view>
