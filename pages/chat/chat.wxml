<view class="chat-page {{keyboardOpen?'keyboard-open':''}}" style="{{viewportHeight?'height:'+(viewportHeight-keyboardHeight)+'px;':''}}">
  <block wx:if="{{thread}}">
    <view class="chat-title"><view class="chat-title-main">商品咨询</view><view>卖家回复为预设演示内容</view></view>
    <button class="product-banner" bindtap="openProduct" aria-label="查看商品详情"><image wx:if="{{photo}}" class="product-mark" src="{{photo}}" mode="aspectFill" binderror="photoError"/><view wx:else class="product-mark">物</view><view class="product-summary"><view class="product-title">{{thread.product.title}}</view><view class="product-price">{{thread.product.sale_mode==='auction'?'起拍 ':''}}¥{{productPrice}} · {{thread.product.condition}}</view><view wx:if="{{thread.product.sale_mode==='auction'}}" class="auction-caption">当前出价与截止状态请以详情为准</view></view><text class="product-arrow">›</text></button>
    <view class="demo-note"><view>本机模拟会话 · 不联系真实卖家 · 不处理付款</view><view>{{isMine?'这是你自己发布的物品，历史会话仅供查看':'最多保存最近 100 条消息'}}</view></view>
    <scroll-view class="messages" scroll-y scroll-into-view="{{anchor}}" scroll-with-animation>
      <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="message-row {{item.role==='me'?'mine':''}}"><view class="message-avatar">{{item.role==='me'?'我':'同'}}</view><view class="message-stack"><view class="sender">{{item.role==='me'?'我':'模拟卖家 · 自动回复'}}</view><view class="message-content">{{item.text}}</view><view class="message-time">{{item.time}}</view></view></view><view class="bottom-space"></view>
    </scroll-view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{!isMine}}" class="quick-questions"><button wx:for="{{questions}}" wx:key="label" data-question="{{item.text}}" bindtap="quickQuestion" disabled="{{sending}}">{{item.label}}</button></view>
    <view wx:if="{{!isMine}}" class="composer"><input value="{{draft}}" maxlength="500" placeholder="输入想问的问题…" disabled="{{sending}}" bindinput="input" bindconfirm="send" bindfocus="focusInput" bindblur="blurInput" bindkeyboardheightchange="onKeyboardHeightChange" focus="{{inputFocused}}" confirm-type="send" adjust-position="{{false}}" hold-keyboard="{{true}}"/><button bindtap="send" loading="{{sending}}" disabled="{{sending||!canSend}}">发送</button></view>
  </block>
  <view wx:else class="empty">{{error||'正在读取会话…'}}<button bindtap="goBack">返回消息列表</button></view>
</view>
