.publish-page{padding-bottom:190rpx}.heading{display:flex;align-items:center;justify-content:space-between;margin:8rpx 0 20rpx}.school-name{font-size:24rpx;color:#6e7f70}.notice{color:#73806f;font-size:24rpx;line-height:1.7;margin-bottom:24rpx}.publish-tabs{display:flex;padding:7rpx;background:#ecefe3;border-radius:19rpx;margin-bottom:26rpx;gap:5rpx}.publish-tabs button{flex:1;margin:0;padding:15rpx 2rpx;line-height:1.4;border-radius:14rpx;font-size:24rpx;color:#667b60;background:transparent}.publish-tabs button.active{background:#33654f;color:#fff;font-weight:600}.form-card{padding:28rpx;background:#fffefa;border:1rpx solid #e0e5d6;border-radius:24rpx}.field{margin-bottom:28rpx}.label{font-size:26rpx;font-weight:600;margin-bottom:14rpx}.label>text{color:#9d663e}.field input,.picker-value,.field textarea{width:100%;padding:21rpx;border-radius:14rpx;background:#f7f7f0;border:1rpx solid #e3e7d9;font-size:26rpx;line-height:1.6;min-height:84rpx}.field input{height:86rpx}.field textarea{min-height:160rpx}.field textarea.body-input{min-height:250rpx}.picker-value{display:flex;justify-content:space-between}.picker-value text{color:#6d836a}.field-note{font-size:23rpx;line-height:1.7;color:#7c8674;margin-top:12rpx}.error{color:#a13e27;line-height:1.7;font-size:25rpx;padding:20rpx 0}.submit{background:#33654f;color:white;font-weight:600;line-height:1.5;padding:23rpx;margin:28rpx 0 0}.submit[disabled]{background:#a1b3a3;color:white}
.school-confirm{background:#f1f4e9;border-radius:14rpx;padding:20rpx 22rpx;margin-bottom:28rpx;display:flex;justify-content:space-between;gap:20rpx;font-size:25rpx}.school-confirm>text{color:#7a8772}.school-confirm>view{font-weight:600}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.form-grid .field{min-width:0}.date-grid>picker{min-width:0}.upload-field{border:1rpx dashed #ccd7bf;background:#f7f8f0;border-radius:20rpx;padding:16rpx;margin-bottom:28rpx}.upload-field>button{background:transparent;padding:10rpx;font-size:26rpx;color:#3e664e;text-align:center;line-height:1.6}.upload-plus{font-size:44rpx;line-height:1.3}.upload-title{font-weight:600}.selected-file{display:flex;gap:14rpx;align-items:center;background:#eef3e5;border-radius:14rpx;padding:18rpx;margin-top:16rpx}.selected-file>view{flex:1;min-width:0}.selected-file text{font-size:25rpx;word-break:break-all}.selected-file>view>view{font-size:22rpx;color:#7c8971;margin-top:10rpx}.selected-file .remove-file{background:#fffefa;font-size:23rpx;line-height:1.5;padding:12rpx 17rpx;margin:0;flex-shrink:0;color:#677b60;border:1rpx solid #d4dfc7}.photo-preview{display:flex;gap:16rpx;margin:20rpx 0;flex-wrap:wrap}.photo-item{width:calc((100% - 32rpx)/3);position:relative;min-width:0}.photo-item image{width:100%;height:155rpx;border-radius:14rpx;background:#e8ecdf}.photo-item>button{position:absolute;right:3rpx;top:3rpx;padding:0;width:42rpx;height:42rpx;line-height:40rpx;background:rgba(34,54,42,.85);color:#fff;border-radius:50%;font-size:29rpx;margin:0}.photo-item>view{font-size:20rpx;color:#7f8b74;text-align:center;margin-top:7rpx}.confirmation{margin-top:28rpx}.confirmation label{display:flex;align-items:flex-start;font-size:24rpx;line-height:1.8;color:#5b6f54}.confirmation checkbox{transform:scale(.82);transform-origin:left top;flex-shrink:0;width:50rpx}.confirmation text{flex:1}
