.publish-page { padding-bottom: 190rpx; }
.publish-intro { padding: 4rpx 2rpx 28rpx; }
.heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin: 0 0 14rpx; }
.heading .section-title { flex: 1; min-width: 0; font-size: 38rpx; line-height: 1.4; letter-spacing: .5rpx; }
.school-name { flex: none; max-width: 46%; padding: 8rpx 16rpx; border: 1rpx solid #dce5d7; border-radius: 30rpx; background: #edf2e8; color: #56725d; font-size: 25rpx; line-height: 1.6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notice { color: #697a6e; font-size: 26rpx; line-height: 1.8; }
.publish-tabs { display: flex; gap: 4rpx; margin-bottom: 28rpx; padding: 7rpx; border: 1rpx solid #e0e5dc; border-radius: 26rpx; background: #ecefe6; }
.publish-page .publish-tabs button { flex: 1; min-width: 0; width: auto; margin: 0; min-height: 78rpx; padding: 19rpx 2rpx; border-radius: 20rpx; background: transparent; color: #637568; font-size: 26rpx; line-height: 1.5; }
.publish-page .publish-tabs button.active { background: #fffefa; color: #294f3e; font-weight: 650; box-shadow: 0 2rpx 5rpx rgba(34, 55, 40, .06), 0 1rpx 2rpx rgba(34, 55, 40, .04); }
.form-card { padding: 28rpx; border: 1rpx solid #e1e5dd; border-radius: 28rpx; background: #fffefa; box-shadow: 0 8rpx 28rpx rgba(46, 70, 48, .035); }
.form-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; color: #294d3c; font-size: 32rpx; font-weight: 650; line-height: 1.5; }
.form-heading > text { flex: none; color: #748273; font-size: 24rpx; font-weight: 400; }
.school-confirm { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 30rpx; padding: 20rpx 22rpx; border-radius: 16rpx; background: #eff3e9; font-size: 28rpx; line-height: 1.6; }
.school-confirm > text { flex: none; color: #697b6c; }
.school-confirm > view { min-width: 0; color: #3d6049; font-weight: 600; text-align: right; word-break: break-all; }
.field { margin-bottom: 32rpx; }
.label { margin-bottom: 14rpx; color: #365341; font-size: 29rpx; font-weight: 600; line-height: 1.5; }
.label > text { margin-left: 4rpx; color: #a06f4a; }
.field input, .picker-value, .field textarea { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 21rpx 22rpx; border: 1rpx solid #e0e5da; border-radius: 20rpx; background: #f7f8f3; color: #2d4b39; font-size: 30rpx; line-height: 1.65; }
.field input { height: 90rpx; }
.field textarea { min-height: 180rpx; }
.field textarea.body-input { min-height: 260rpx; }
.picker-value { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.picker-value text { flex: none; margin-left: auto; color: #6b826c; }
.field-note { margin-top: 12rpx; color: #6e7e6f; font-size: 25rpx; font-weight: 400; line-height: 1.75; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.form-grid .field, .date-grid > picker { min-width: 0; }
.upload-field { margin-bottom: 30rpx; padding: 18rpx; border: 1rpx dashed #c8d5c1; border-radius: 24rpx; background: #f7f9f2; }
.publish-page .upload-field > button { width: 100%; margin: 0; padding: 14rpx 8rpx; background: transparent; color: #3e664e; text-align: center; font-size: 30rpx; line-height: 1.6; }
.upload-symbol { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 0 auto 14rpx; border-radius: 22rpx; background: #e6eedc; }
.upload-symbol image { display: block; width: 42rpx; height: 42rpx; }
.upload-title { color: #365c45; font-weight: 600; }
.selected-file { display: flex; align-items: center; gap: 14rpx; margin-top: 16rpx; padding: 18rpx; border-radius: 16rpx; background: #eaf1e2; }
.selected-file > view { flex: 1; min-width: 0; }
.selected-file text { font-size: 28rpx; line-height: 1.6; word-break: break-all; }
.selected-file > view > view { margin-top: 8rpx; color: #738268; font-size: 24rpx; line-height: 1.6; }
.publish-page .selected-file .remove-file { flex: none; width: auto; min-width: 84rpx; min-height: 72rpx; margin: 0; padding: 16rpx 18rpx; border: 1rpx solid #d2dec5; border-radius: 14rpx; background: #fffefa; color: #657758; font-size: 25rpx; line-height: 1.6; }
.photo-preview { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 22rpx 0; }
.photo-item { position: relative; width: calc((100% - 32rpx) / 3); min-width: 0; }
.photo-item image { display: block; width: 100%; height: 165rpx; border: 1rpx solid #dfe6d5; border-radius: 17rpx; background: #e9eddf; }
.publish-page .photo-item > button { display: flex; align-items: center; justify-content: center; position: absolute; right: 0; top: 0; width: 72rpx; min-width: 72rpx; height: 72rpx; margin: 0; padding: 0; border-radius: 16rpx; background: transparent; color: #fff; font-size: 30rpx; line-height: 1; }
.photo-item > button > text { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border: 2rpx solid #fffefa; border-radius: 50%; background: rgba(34, 54, 42, .84); }
.photo-item > view { margin-top: 9rpx; color: #77866f; text-align: center; font-size: 23rpx; line-height: 1.6; }
.confirmation { margin-top: 30rpx; padding-top: 26rpx; border-top: 1rpx solid #e6eadf; }
.confirmation label { display: flex; align-items: flex-start; color: #5b7056; font-size: 26rpx; line-height: 1.8; }
.confirmation checkbox { flex: none; width: 50rpx; transform: scale(.82); transform-origin: left top; }
.confirmation text { flex: 1; min-width: 0; }
.error { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 14rpx; background: #fbede5; color: #a04e34; font-size: 27rpx; line-height: 1.7; }
.publish-page button.submit { width: 100%; margin: 28rpx 0 0; min-height: 94rpx; padding: 25rpx 18rpx; border-radius: 24rpx; background: #315f4b; color: #fffefa; font-size: 31rpx; font-weight: 600; line-height: 1.5; box-shadow: 0 7rpx 16rpx rgba(45, 84, 64, .1); }
.publish-page button.submit[disabled] { background: #a1b3a3; color: #fff; box-shadow: none; }
.publish-page .footnote { margin-top: 28rpx; color: #6f7d70; font-size: 24rpx; line-height: 1.8; }

.publish-page input:focus, .publish-page textarea:focus { border-color: #8da88e; background: #fffefa; }
.publish-page .publish-tabs button[disabled] { opacity: .6; }
