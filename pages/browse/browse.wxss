.page button.back-top { position:fixed; z-index:40; right:25rpx; bottom:calc(185rpx + env(safe-area-inset-bottom)); width:80rpx; height:80rpx; margin:0; padding:0; line-height:80rpx; background:#fffef9; color:#4d743f; font-size:38rpx; border:1rpx solid #cbdab9; border-radius:26rpx; box-shadow:0 6rpx 22rpx rgba(45,72,37,.12); }
/* Native press feedback only; browsing and filtering remain immediate. */
.resource-card,.product-open,.compare-item { transition:transform 140ms cubic-bezier(.23,1,.32,1),opacity 140ms cubic-bezier(.23,1,.32,1); }
.page button.ui-pressed { transform:scale(.98); opacity:.9; }
.surface-pressed { transform:scale(.99); opacity:.92; }
.page button[disabled] { transform:none; }
@media (prefers-reduced-motion:reduce) { .resource-card,.product-open,.compare-item { transition:none; } .page button.ui-pressed,.surface-pressed { transform:none; } }

/* Keep all resource filters within one surface, with space for touch targets. */
.filters .filter-row { margin:0 0 10rpx; }
.filters .filter-picker { flex:1; min-width:0; }
.filters .filter-picker view { gap:8rpx; }
