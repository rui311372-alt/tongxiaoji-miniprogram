.page button.compare-toggle { width:100%; min-height:72rpx; margin:0; padding:15rpx 8rpx; background:#f1f4e9; color:#5d784e; border-top:1rpx solid #e6ecdc; font-size:24rpx; border-radius:0; line-height:1.6; }
