.topic-card>text { color:#526b5e; }
.page button.refresh-button { display:flex; align-items:center; justify-content:center; gap:10rpx; width:auto; min-height:64rpx; margin:0; padding:10rpx 14rpx; border:1rpx solid #bed2dc; border-radius:14rpx; background:#edf4f8; color:#2a6279; font-size:27rpx; line-height:1.6; }

/* Keep market actions beside the content they affect. */
.wanted-controls { display:flex; align-items:center; gap:10rpx; margin:14rpx 0 18rpx; }
.wanted-statuses { display:flex; align-items:center; flex:1; min-width:0; gap:6rpx; }
