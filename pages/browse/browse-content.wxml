<campus-header school-id="{{school.id}}" bind:schoolchange="onSchoolChanged" />
<view class="page campus-content">
  <button wx:if="{{topic}}" class="topic-back" bindtap="backToLibrary" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">‹ 返回学习资料</button>
  <view class="feature-heading"><view class="section-title">{{topicTitle || (section === 'resources' ? '学习资料' : '二手集市')}}</view><view class="heading-caption">{{school.name}} · {{topic === 'review' ? reviewTotal + ' 份复习提纲，按专业与课程查找' : topic === 'help' ? requestTotal + ' 条待回应求助，分享资料补齐所需' : section === 'resources' ? resourceTotal + ' 份整理，免费互助共享' : productTotal + ' 件好物，等你来逛'}}</view></view>
  <view class="search-box">
    <view class="search-symbol" aria-hidden="true"></view>
    <input class="search" value="{{keyword}}" placeholder="{{topic === 'help' ? '搜索课程或同学需要的资料' : section === 'resources' ? '搜索课程、知识点或资料名称' : '找物品，也可以搜交接地点'}}" bindinput="onSearch" bindconfirm="confirmSearch" confirm-type="search" maxlength="60" />
    <button wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword" aria-label="清空搜索关键词" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">×</button>
  </view>
  <view wx:if="{{!keyword && searches.length}}" class="recent"><text>最近搜过</text><button wx:for="{{searches}}" wx:key="*this" class="tiny-chip" data-value="{{item}}" bindtap="useSearch" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{item}}</button><button class="text-link" bindtap="clearSearches" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">清空</button></view>
  <block wx:if="{{section === 'resources' && !topic}}">
    <view class="topic-shortcuts"><button class="topic-card {{category === '复习提纲' ? 'selected' : ''}}" bindtap="reviewTopic" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><image src="/assets/nav/topic-review.png" /><view>期末冲刺</view><text>{{reviewTotal}} 份提纲</text></button><button class="topic-card" bindtap="practiceTopic" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><image src="/assets/nav/topic-practice.png" /><view>刷题练习</view><text>64 道选择题</text></button><button class="topic-card {{libraryTab === 'requests' ? 'selected' : ''}}" bindtap="helpTopic" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><image src="/assets/nav/topic-help.png" /><view>互助补齐</view><text>{{requestTotal}} 条求助</text></button></view>
  </block>
  <view wx:if="{{section === 'market'}}" class="sub-tabs"><button class="sub-tab {{marketTab === 'products' ? 'active' : ''}}" data-tab="products" bindtap="changeMarket" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">二手闲置</button><button class="sub-tab {{marketTab === 'wanted' ? 'active' : ''}}" data-tab="wanted" bindtap="changeMarket" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">求闲置</button><button class="sub-tab {{marketTab === 'auctions' ? 'active' : ''}}" data-tab="auctions" bindtap="changeMarket" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">拍卖专区</button></view>
  <view class="error-box" wx:if="{{error}}">{{error}}<button class="more" bindtap="refresh" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">重新读取</button></view>
  <view class="tools-hint" wx:if="{{toolsHint}}">{{toolsHint}}</view>
  <block wx:if="{{section === 'resources' && libraryTab === 'resources'}}">
    <view wx:if="{{!topic}}" class="collection-label">学习路线</view><scroll-view wx:if="{{!topic}}" scroll-x class="collection-scroll"><view class="collection-row"><button wx:for="{{collections}}" wx:key="id" class="collection-chip {{collectionId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectCollection" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{item.title}}</button></view></scroll-view>
    <view wx:if="{{activeCollection}}" class="collection-intro"><text class="small-label">本校学习专题 · 按顺序读</text><view class="item-title">{{activeCollection.title}}</view><view class="request-description">{{activeCollection.description}}</view></view>
    <view class="filters"><view class="filter-title">专业、课程与评分筛选</view><view class="filter-body"><view class="filter-row"><picker class="filter-picker" range="{{majorOptions}}" value="{{majorIndex}}" bindchange="changeMajor"><view>专业 · {{majorOptions[majorIndex]}} ▾</view></picker><picker class="filter-picker" range="{{courseOptions}}" value="{{courseIndex}}" bindchange="changeCourse"><view>课程 · {{courseOptions[courseIndex]}} ▾</view></picker></view><button class="rated-toggle {{ratedOnly ? 'selected' : ''}}" bindtap="toggleRated" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{ratedOnly ? '✓ ' : ''}}只看有同学评分</button><text class="small-label">课堂预置分值与本机使用反馈分开统计。</text></view></view>
    <scroll-view wx:if="{{topic !== 'review'}}" scroll-x class="chips-scroll"><view class="chips"><button wx:for="{{resourceCategories}}" wx:key="*this" class="chip {{category === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="setCategory" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{item}}</button></view></scroll-view>
    <view class="quick-filters"><button class="filter-pill {{goldOnly ? 'active gold-active' : ''}}" bindtap="toggleGoldOnly" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{goldOnly ? '✓ ' : '✦ '}}只看平台金选</button><button class="filter-pill favorite-filter {{savedOnly ? 'active' : ''}}" bindtap="toggleSavedOnly" aria-label="{{savedOnly ? '显示全部资料' : '只看已收藏资料'}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><image class="heart-icon" src="{{savedOnly ? '/assets/nav/heart-filled.png' : '/assets/nav/heart-outline.png'}}" mode="aspectFit" /><text>只看已收藏</text></button></view>
  </block>
  <block wx:elif="{{section === 'market' && marketTab !== 'wanted'}}"><view class="filter-row"><picker class="filter-picker" range="{{budgetOptions}}" value="{{budgetIndex}}" data-key="budgetIndex" bindchange="changeFilter"><view>{{budgetOptions[budgetIndex]}} ▾</view></picker><picker class="filter-picker" range="{{conditionOptions}}" value="{{conditionIndex}}" data-key="conditionIndex" bindchange="changeFilter"><view>{{conditionOptions[conditionIndex]}} ▾</view></picker><picker wx:if="{{school.id === 'tianjin'}}" class="filter-picker" range="{{campusOptions}}" value="{{campusIndex}}" data-key="campusIndex" bindchange="changeFilter"><view>{{campusOptions[campusIndex]}} ▾</view></picker></view><scroll-view scroll-x class="chips-scroll"><view class="chips"><button wx:for="{{productCategories}}" wx:key="*this" class="chip {{category === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="setCategory" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{item}}</button></view></scroll-view><view wx:if="{{marketTab === 'auctions'}}" class="auction-intro">校内好物，试试竞拍<text>本机模拟出价 · 不涉及支付 · 结束后最高出价者可预约</text></view></block>
  <view wx:elif="{{section === 'resources'}}" class="filter-row"><picker class="filter-picker" range="{{requestStatusOptions}}" value="{{requestStatusIndex}}" data-key="requestStatusIndex" bindchange="changeFilter"><view>{{requestStatusOptions[requestStatusIndex]}} ▾</view></picker><button class="small-primary" bindtap="publishRequest" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">发布求资料</button></view>
  <view wx:else class="wanted-heading"><text>把想找的物品写清楚，更容易遇到。</text><button class="small-primary" bindtap="publishRequest" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">发布求闲置</button></view>
  <view wx:if="{{section === 'market' && marketTab !== 'products'}}" class="market-controls"><view class="chips"><button class="chip {{marketFilter === 'all' ? 'selected' : ''}}" data-value="all" bindtap="setMarketFilter" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">全部</button><button class="chip {{marketFilter === 'open' || marketFilter === 'active' ? 'selected' : ''}}" data-value="{{marketTab === 'wanted' ? 'open' : 'active'}}" bindtap="setMarketFilter" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{marketTab === 'wanted' ? '寻找中' : '进行中'}}</button><button class="chip {{marketFilter === 'resolved' || marketFilter === 'ended' ? 'selected' : ''}}" data-value="{{marketTab === 'wanted' ? 'resolved' : 'ended'}}" bindtap="setMarketFilter" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{marketTab === 'wanted' ? '已找到' : '已结束'}}</button><button class="chip {{marketFilter === 'mine' ? 'selected' : ''}}" data-value="mine" bindtap="setMarketFilter" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">我发布的</button></view><view class="market-tools"><button class="text-link" bindtap="refresh" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">↻ 刷新</button><button wx:if="{{marketTab === 'auctions'}}" class="text-link" bindtap="openMyAuctions" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">我的竞拍 →</button><button wx:if="{{marketTab === 'auctions'}}" class="text-link" bindtap="publishAuction" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">+ 发布拍卖</button></view></view>
  <view class="list-heading"><view><text>{{section === 'resources' ? (libraryTab === 'requests' ? '同学在找这些资料' : '同学们的整理') : (marketTab === 'wanted' ? '同学想找的闲置' : marketTab === 'auctions' ? '本校拍卖' : '逛逛本校闲置')}}</text><view class="result-count">找到 {{total}} {{section === 'resources' ? '条' : '件'}} · {{school.name}}</view></view><picker wx:if="{{(section === 'resources' && libraryTab === 'resources') || (section === 'market' && marketTab !== 'wanted')}}" range="{{sortOptions}}" value="{{sortIndex}}" data-key="sortIndex" bindchange="changeFilter"><view class="sort-picker">{{sortOptions[sortIndex]}} ▾</view></picker></view>
  <view wx:if="{{activeFilters.length && !error}}" class="active-filters">
    <view class="active-filter-heading"><text>已选条件 · {{activeFilters.length}}</text><button class="text-link reset-filters" bindtap="clearFilters" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">全部重置</button></view>
    <view class="active-filter-list"><button wx:for="{{activeFilters}}" wx:key="key" class="active-filter-chip" data-key="{{item.key}}" bindtap="removeFilter" aria-label="{{'移除条件：' + item.label}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><text class="active-filter-label">{{item.label}}</text><text class="active-filter-close" aria-hidden="true">×</text></button></view>
  </view>
  <block wx:if="{{section === 'resources' && libraryTab === 'resources'}}"><view class="resource-wrapper" wx:for="{{items}}" wx:key="id"><view class="resource-card" data-id="{{item.id}}" bindtap="openDetail" hover-class="surface-pressed" hover-start-time="0" hover-stay-time="80"><view class="score" data-id="{{item.id}}" data-focus="reviews" catchtap="openDetail"><view class="score-caption">资料评分</view><view class="score-value-row"><text class="score-number {{!item.hasScore ? 'pending' : ''}}">{{item.scoreLabel}}</text><text wx:if="{{item.hasScore}}" class="score-denominator">/5</text></view><view wx:if="{{item.hasScore}}" class="score-stars"><text>★★★★★</text><text class="score-stars-fill" style="width:{{item.scorePercent}}%">★★★★★</text></view><text class="score-label">{{item.scoreSource}}</text><text wx:if="{{item.gold}}" class="gold" data-id="{{item.id}}" data-focus="gold" catchtap="openDetail">平台金选</text></view><view class="resource-body"><view class="resource-type"><text class="pill">{{item.category}}</text><text>{{item.format}}</text></view><view class="item-title">{{item.title}}</view><view class="item-description">{{item.description}}</view><view class="item-meta">{{item.course}} · {{item.major}}</view></view></view><view class="card-bottom"><view class="author resource-author"><text class="author-name">{{item.authorName}}{{item.authorDemo ? ' · 示例' : ''}}</text><text class="download-count">{{item.downloadsDemo ? '示例下载' : '下载 / 导出'}} {{item.downloads}} 次</text></view><button class="credit-pill" data-id="{{item.id}}" bindtap="openCredit" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">信用 {{item.authorCredit}}</button><button class="save-icon {{item.favorite ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleFavorite" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><image class="heart-icon" src="{{item.favorite ? '/assets/nav/heart-filled.png' : '/assets/nav/heart-outline.png'}}" mode="aspectFit" /></button></view></view></block>
  <block wx:elif="{{section === 'resources'}}"><view class="request-card" wx:for="{{items}}" wx:key="id"><view class="request-top"><text class="pill">{{item.status === 'resolved' ? '已解决' : '寻找中'}}</text><text>{{item.course}}</text></view><view class="item-title">{{item.title}}</view><view class="request-description">{{item.description}}</view><view class="request-footer"><text class="author">{{item.authorName}}{{item.authorDemo ? ' · 示例' : ''}}</text><button class="request-action" data-id="{{item.id}}" bindtap="openRequest" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{item.status === 'resolved' ? '查看关联资料' : '我来分享'}}</button></view><picker wx:if="{{item.isLocal && item.status !== 'resolved'}}" range="{{resourceChoices}}" range-key="title" data-id="{{item.id}}" bindchange="resolveRequest"><view class="resolve-link">标记已解决并关联本校资料 ▾</view></picker><button wx:if="{{item.isLocal && item.status === 'resolved'}}" class="text-link" data-id="{{item.id}}" bindtap="reopenRequest" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">重新寻找</button></view></block>
  <view wx:elif="{{marketTab !== 'wanted'}}" class="product-grid"><view class="product-card" wx:for="{{items}}" wx:key="id"><view class="product-open" data-id="{{item.id}}" bindtap="openDetail" hover-class="surface-pressed" hover-start-time="0" hover-stay-time="80"><image class="product-image" wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFit" lazy-load /><view class="product-placeholder" wx:else>待上传物品照片</view><view class="product-info"><text class="pill">{{item.condition}}</text><view class="item-title product-title">{{item.title}}</view><view class="price">¥{{item.price}}<text>{{item.auctionPriceLabel}}</text></view><view class="place">{{item.place}}</view><view wx:if="{{item.auction}}" class="auction-state"><view class="auction-card-status {{item.auctionTone}}">{{item.auctionLabel}}</view><text>{{item.auction.bid_count}} 次出价</text></view><view wx:if="{{item.auction}}" class="auction-card-clock">{{item.auctionClock}}</view></view></view><view class="card-bottom product-bottom"><text class="author">{{item.authorName}}</text><button class="save-icon {{item.favorite ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleFavorite" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><image class="heart-icon" src="{{item.favorite ? '/assets/nav/heart-filled.png' : '/assets/nav/heart-outline.png'}}" mode="aspectFit" /></button></view><button wx:if="{{marketTab === 'products'}}" class="compare-toggle {{item.compared ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleCompare" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{item.compared ? '✓ 已加入比较' : '+ 加入比较'}}</button></view></view>
  <block wx:else><view class="request-card" wx:for="{{items}}" wx:key="id"><view class="request-top"><text class="pill">{{item.status === 'resolved' ? '已找到' : '求闲置'}}</text><text>{{item.budget_cents ? '预算 ¥' + item.price : '预算再沟通'}}</text></view><view class="item-title">{{item.title}}</view><view class="request-description">{{item.description}}</view><view class="place">{{item.place}}</view><view class="request-footer"><text class="author">{{item.authorName}}{{item.isLocal ? '' : ' · 示例'}}</text><button wx:if="{{!item.isLocal && item.status !== 'resolved'}}" class="request-action" bindtap="offerSimilar" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">我有类似闲置</button><button wx:if="{{item.isLocal}}" class="request-action" data-id="{{item.id}}" data-status="{{item.status === 'resolved' ? 'open' : 'resolved'}}" bindtap="updateWanted" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{item.status === 'resolved' ? '重新寻找' : '标记已找到'}}</button></view></view></block>
  <view wx:if="{{comparedCount && section === 'market'}}" class="comparison"><view class="comparison-heading"><button class="text-link" bindtap="toggleComparison" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">比较清单 {{comparedCount}} / 3 {{comparisonOpen ? '▴' : '▾'}}</button><button class="text-link" bindtap="clearComparison" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">清空</button></view><view wx:if="{{comparisonOpen}}" class="comparison-items"><view wx:for="{{comparison}}" wx:key="id" class="compare-item" data-id="{{item.id}}" bindtap="openDetail" hover-class="surface-pressed" hover-start-time="0" hover-stay-time="80"><image src="{{item.photo}}" mode="aspectFit"/><view>{{item.title}}</view><text>¥{{item.price}} · {{item.condition}}</text><text>{{item.place}}</text></view></view></view>
  <view wx:if="{{total === 0 && !error}}" class="empty list-empty">
    <view class="empty-symbol" aria-hidden="true"><view class="search-symbol"></view></view>
    <view class="empty-title">{{activeFilters.length ? '暂时没有匹配内容' : '这里还没有内容'}}</view>
    <view class="empty-description">{{activeFilters.length ? '放宽一些条件，可能就有你需要的。' : '写下你的需求，让同校同学来帮忙。'}}</view>
    <button wx:if="{{activeFilters.length}}" class="more empty-reset" bindtap="clearFilters" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{topic === 'review' ? '查看全部复习提纲' : topic === 'help' ? '查看全部求助' : '清除条件，恢复浏览'}}</button>
    <button class="text-link empty-publish" bindtap="publishRequest" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{section === 'market' ? '+ 发布求闲置' : '+ 发布求资料'}}</button>
  </view>
  <button wx:if="{{hasMore}}" class="more" bindtap="loadMore" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">再看一些</button>
  <view class="footnote">课堂演示 · 认证与交易均为模拟体验</view>
  <button wx:if="{{showBackTop}}" class="back-top" bindtap="backTop" aria-label="回到顶部" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">↑</button>
</view>
<campus-nav active="{{activeNav}}" bind:select="onMainNav" />
