.detail-title { margin-top: 25rpx; font-size: 38rpx; font-weight: 750; line-height: 1.6; }
.detail-meta { color: #82907d; font-size: 24rpx; line-height: 1.7; margin-top: 18rpx; }
.rating { display: flex; align-items: center; padding: 23rpx; margin-top: 24rpx; background: #f1ecd9; border-radius: 18rpx; color: #9b813e; font-size: 22rpx; }
.rating-number { font-size: 43rpx; font-weight: 700; margin-right: 17rpx; }
.selection { margin-left: auto; color: #907027; }
.description { color: #7b8879; font-size: 25rpx; line-height: 1.9; margin-top: 24rpx; }
.copy { color: #396345; background: #e9eddf; margin: 25rpx 0; font-size: 25rpx; }
.reading { white-space: pre-wrap; word-break: break-all; line-height: 1.95; font-size: 28rpx; padding: 26rpx; background: #fffefb; border: 1rpx solid #e3e7d9; border-radius: 20rpx; margin-top: 22rpx; }
.detail-photo { display: block; width: 100%; height: 340rpx; border-radius: 20rpx; background: #eeefe7; margin-top: 20rpx; }
.photo-label { color: #8b9584; font-size: 21rpx; text-align: center; margin-top: 10rpx; }
.price { color: #ac623e; font-size: 48rpx; font-weight: 750; margin-top: 26rpx; }
.price text { color: #7f8c76; font-size: 24rpx; font-weight: 400; margin-left: 23rpx; }
.place { margin-top: 20rpx; color: #7c8a73; font-size: 24rpx; line-height: 1.8; }

.page button.favorite-button { width: 100%; max-width: none; margin: 28rpx 0 0; padding: 8rpx 20rpx; background: #2f684e; color: #fff; font-size: 27rpx; }
.page button.favorite-button.saved { background: #e9eddf; color: #496843; }
.page button.copy { width: 100%; max-width: none; }

.page button.chat-button { width:100%; margin:28rpx 0 0; background:#e9efdf; color:#577447; border:1rpx solid #ccdabd; }
.detail-page { padding-bottom:calc(180rpx + env(safe-area-inset-bottom)); }
.page button.primary,.page button.secondary { width:auto; margin:0; font-size:24rpx; line-height:1.7; padding:18rpx 24rpx; border-radius:13rpx; }
.page button.primary { background:#608a45; color:#fffefa; }
.page button.secondary { background:#edf1e4; color:#71855b; border:1rpx solid #dce5cd; }
.page button.text-link { width:auto; margin:0; padding:12rpx 0; line-height:1.7; font-size:23rpx; color:#87965f; background:transparent; }
.small-label { color:#9ca68f; font-size:21rpx; line-height:1.8; }
.author-card { display:flex; align-items:center; gap:15rpx; margin:25rpx 0; }
.author-card>image,.author-mark { width:62rpx; height:62rpx; flex-shrink:0; border-radius:50%; background:#e8edde; }
.author-mark { display:flex; align-items:center; justify-content:center; font-size:26rpx; color:#8da36e; }
.author-copy { flex:1; min-width:0; font-size:23rpx; line-height:1.7; color:#688057; }
.author-copy text { display:block; color:#a1aa96; font-size:20rpx; }
.page button.credit-badge { width:auto; margin:0; padding:7rpx 13rpx; line-height:1.8; background:#edf2e2; color:#8aa06e; font-size:20rpx; border-radius:25rpx; white-space:nowrap; }
.rating { flex-direction:column; align-items:flex-start; gap:6rpx; background:#f4efdf; }
.rating>text { color:#a69a77; font-size:20rpx; }
.gold-panel { padding:24rpx; margin-top:24rpx; background:#f6f0dc; border:1rpx solid #e8dcad; border-radius:16rpx; font-size:24rpx; line-height:1.9; color:#a28b50; }
.gold-heading { margin-bottom:13rpx; }
.gold-heading>text:first-child { font-size:28rpx; font-weight:600; }
.gold-heading .small-label { display:block; color:#ad9d71; }
.gold-criterion { font-size:22rpx; margin:10rpx 0; }
.panel { padding:25rpx; border:1rpx solid #e0e6d5; border-radius:17rpx; background:#fffefa; margin-top:25rpx; }
.panel-heading { color:#587340; font-size:29rpx; line-height:1.7; font-weight:600; margin-bottom:15rpx; }
.panel-heading>text { float:right; font-size:21rpx; color:#a0ac8b; font-weight:400; }
.attachment { display:flex; align-items:center; gap:20rpx; padding:22rpx; border:1rpx solid #e1e7d7; background:#fffefa; border-radius:15rpx; margin:26rpx 0; }
.attachment>view { min-width:0; flex:1; }
.attachment-format { color:#8aa36c; font-size:20rpx; text-transform:uppercase; }
.attachment-name { color:#657e50; font-size:25rpx; line-height:1.7; word-break:break-all; }
.attachment button { flex-shrink:0; }
.reading-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin:24rpx 0; }
.reading-actions>text { color:#a0aa92; font-size:20rpx; }
.next-panel { background:#eaf0df; color:#6f8855; padding:22rpx; font-size:25rpx; line-height:1.8; margin-top:26rpx; border-radius:15rpx; }
.next-panel .small-label { margin-bottom:8rpx; }
.distribution { padding:18rpx 0; }
.distribution-row { display:flex; gap:12rpx; align-items:center; margin:8rpx 0; font-size:21rpx; color:#a4a284; }
.distribution-track { flex:1; height:10rpx; border-radius:8rpx; background:#f1f0e7; overflow:hidden; }
.distribution-track>view { height:100%; background:#c4b16e; }
.review { border-top:1rpx solid #e9edde; padding:22rpx 0; }
.review-top { color:#6f8657; font-size:23rpx; display:flex; justify-content:space-between; gap:16rpx; }
.review-top text { color:#b69b55; white-space:nowrap; }
.review-comment { margin:14rpx 0; line-height:1.9; font-size:25rpx; color:#6b7c60; white-space:pre-wrap; word-break:break-all; }
.review-form { border-top:1rpx solid #e6ebdb; padding-top:24rpx; }
.form-label { font-size:25rpx; color:#7c8e67; }
.stars { display:flex; align-items:center; margin:14rpx 0; }
.page button.star { width:50rpx; margin:0 5rpx 0 0; padding:0; line-height:1.8; font-size:39rpx; background:transparent; color:#d5d8ca; }
.page button.star.selected { color:#bda454; }
.stars>text { font-size:21rpx; color:#9ca78d; margin-left:10rpx; }
.review-form textarea,.field { width:100%; min-height:115rpx; padding:20rpx; background:#fafbf6; border:1rpx solid #e0e6d4; border-radius:12rpx; font-size:24rpx; line-height:1.8; color:#627e4b; box-sizing:border-box; }
.form-actions { display:flex; align-items:center; gap:22rpx; margin-top:20rpx; }
.gallery { width:100%; height:340rpx; background:#eff1e7; border-radius:20rpx; overflow:hidden; margin-top:20rpx; }
.gallery image { width:100%; height:100%; }
.photo-empty { height:240rpx; display:flex; justify-content:center; align-items:center; color:#a7b197; background:#f0f2e9; margin-top:20rpx; border-radius:20rpx; }
.auction-panel { background:#f8f4e8; border-color:#e5dfc6; }
.auction-panel .panel-heading { color:#9b8751; }
.bid-stats { display:flex; gap:50rpx; margin:25rpx 0; color:#9c874e; font-size:31rpx; }
.bid-stats text { color:#ada282; font-size:21rpx; display:block; margin-bottom:9rpx; }
.inline-form { display:flex; gap:14rpx; margin:15rpx 0; }
.inline-form input { flex:1; min-width:0; height:77rpx; padding:0 18rpx; border:1rpx solid #e0d9bd; border-radius:12rpx; background:#fffefa; font-size:27rpx; color:#9c874e; }
.bid-row { border-top:1rpx solid #ece5cf; display:flex; align-items:center; justify-content:space-between; gap:15rpx; padding:17rpx 0; color:#a08950; font-size:25rpx; }
.bid-row>view { color:#969879; font-size:23rpx; }
.bid-row>view>text { display:block; color:#b0ad98; font-size:20rpx; margin-top:8rpx; }
.auction-result { font-size:25rpx; color:#988346; line-height:1.8; margin-bottom:20rpx; }
.auction-status-card { padding:18rpx 20rpx; margin:18rpx 0 22rpx; border:1rpx solid #e0e4d6; border-radius:13rpx; background:#f0f2e9; color:#7c8870; }
.auction-status-card>view { font-size:25rpx; font-weight:600; line-height:1.7; }
.auction-status-card>text { display:block; font-size:21rpx; line-height:1.8; margin-top:5rpx; opacity:.85; }
.auction-status-dot { font-size:16rpx; margin-right:10rpx; vertical-align:middle; }
.auction-status-card.leading { color:#437353; background:#eaf3e8; border-color:#d0e1c9; }
.auction-status-card.outbid { color:#986e38; background:#fbf0dc; border-color:#ecdcb9; }
.auction-status-card.active { color:#7d854d; background:#f2f2df; border-color:#e4e3c6; }
.bid-quick-actions { display:flex; gap:12rpx; margin:14rpx 0 10rpx; }
.page button.bid-step { width:auto; margin:0; padding:10rpx 16rpx; font-size:21rpx; line-height:1.7; color:#9b854c; background:#fffaf0; border:1rpx solid #e5ddc2; border-radius:10rpx; }
.page button.bid-step[disabled] { opacity:.5; }
.my-auction-link { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:20rpx 0 8rpx; padding-top:12rpx; border-top:1rpx solid #e8e1cb; }
.my-auction-link>text { font-size:20rpx; color:#a79b78; flex:1; }
.my-auction-link button.text-link { font-size:21rpx; color:#879460; flex-shrink:0; }
.page button.panel-toggle { width:100%; margin:0; padding:0; display:flex; justify-content:space-between; color:#6c8550; font-size:27rpx; line-height:1.8; background:transparent; }
.panel-toggle text { color:#a3af92; font-size:22rpx; }
.checklist .small-label { margin:18rpx 0; }
.page button.check-item { width:100%; display:flex; gap:16rpx; align-items:flex-start; text-align:left; margin:16rpx 0 0; padding:12rpx 0; color:#9aa68a; font-size:23rpx; line-height:1.8; background:transparent; }
.check-square { flex-shrink:0; width:32rpx; height:32rpx; margin-top:5rpx; border:1rpx solid #ccd9b8; border-radius:7rpx; color:#779852; display:flex; align-items:center; justify-content:center; }
.page button.check-item.checked { color:#708b52; }
.check-done { background:#edf3e1; padding:18rpx; font-size:23rpx; color:#819b5a; line-height:1.8; border-radius:12rpx; }
.credit-note { color:#7d9461; background:#eff3e7; font-size:24rpx; line-height:1.8; padding:22rpx; border-radius:14rpx; margin-top:26rpx; }
.credit-note text { color:#a0ac8e; font-size:21rpx; display:block; }
.page button.reserve-open { width:100%; margin-top:25rpx; }
.form-row { display:flex; gap:14rpx; margin-top:20rpx; }
.form-row picker { flex:1; }
.form-picker { padding:19rpx; border:1rpx solid #dce5cc; border-radius:12rpx; color:#6e8756; font-size:25rpx; }
.reservation .field { margin-top:18rpx; }
.reservation input.field { height:85rpx; min-height:0; }
.reservation button.primary { width:100%; margin-top:20rpx; }
.form-error { color:#b08058; font-size:23rpx; line-height:1.8; margin-top:15rpx; }
.related { margin-top:35rpx; }
.page button.related-item { display:flex; justify-content:space-between; gap:20rpx; text-align:left; width:100%; margin:14rpx 0; padding:20rpx; font-size:24rpx; line-height:1.8; background:#fffefa; color:#84976c; border:1rpx solid #e4e9da; border-radius:13rpx; }
.related-item>text { color:#b3bda6; }
.notice { padding:20rpx; color:#b08255; background:#fbf0de; border-radius:13rpx; margin:22rpx 0; font-size:24rpx; line-height:1.9; }
.detail-bar { position:fixed; left:0; right:0; bottom:0; z-index:50; display:flex; gap:18rpx; padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e0e7d4; background:#fffefb; }
.page .detail-bar button { width:auto; flex:1; margin:0; font-size:26rpx; line-height:1.8; padding:18rpx 20rpx; border-radius:15rpx; }
.page button.bar-save { background:#eff3e7; color:#9aa98a; }
.page button.bar-save.saved { color:#ad856c; background:#f5ece2; }
.page button.bar-primary { flex:1.6; background:#688d4a; color:#fffefa; }
.reader-tools { display:flex; align-items:center; justify-content:space-between; gap:15rpx; padding:19rpx 22rpx; margin-top:24rpx; border:1rpx solid #e0e7d4; border-radius:15rpx; background:#f0f3e8; font-size:24rpx; color:#6e8555; }
.reader-tools>view>text { display:block; margin-top:6rpx; color:#a0ac8c; font-size:20rpx; }
.font-controls { display:flex; align-items:center; gap:12rpx; flex-shrink:0; }
.font-controls>text { color:#92a17b; font-size:21rpx; }
.page button.font-button { width:57rpx; height:57rpx; margin:0; padding:0; line-height:57rpx; font-size:24rpx; border:1rpx solid #d8e2c8; border-radius:11rpx; background:#fffefa; color:#769353; }
.page button.font-button[disabled] { color:#c1c9b6; background:#f6f7f0; }
.rating-summary { position:relative; display:flex; align-items:center; gap:27rpx; padding:27rpx; margin-top:26rpx; border:1rpx solid #e8dcb6; border-radius:21rpx; overflow:hidden; background:linear-gradient(120deg,#f9f2dd,#f2efdf 65%,#f9f7ee); }
.rating-summary-left { flex-shrink:0; padding-right:26rpx; border-right:1rpx solid #e8ddbd; }
.rating-large { font-size:58rpx; line-height:1.2; font-weight:750; letter-spacing:-2rpx; color:#a78a41; }
.rating-large>text { color:#bfb18c; font-size:23rpx; font-weight:400; margin-left:7rpx; letter-spacing:0; }
.rating-stars { position:relative; width:120rpx; color:#ddd7c2; font-size:24rpx; line-height:1.8; margin-top:7rpx; white-space:nowrap; }
.rating-stars>text { display:block; }
.rating-stars-fill { position:absolute; left:0; top:0; overflow:hidden; color:#c5a255; white-space:nowrap; }
.rating-summary-copy { position:relative; flex:1; min-width:0; z-index:1; }
.rating-summary-copy>view { font-size:27rpx; font-weight:600; color:#9a854e; }
.rating-summary-copy>text { display:block; color:#a99d7d; font-size:21rpx; line-height:1.7; margin-top:8rpx; }
.rating-summary-copy>text.rating-hint { color:#b7ad91; font-size:19rpx; }
.rating-decoration { position:absolute; right:-2rpx; top:-22rpx; color:#e4d8af; font-size:115rpx; opacity:.35; transform:rotate(12deg); }
.distribution-caption { font-size:21rpx; color:#a2a48c; }
.distribution-track>view { border-radius:8rpx; background:linear-gradient(90deg,#dcc993,#b99d57); }
.classroom-section { margin-top:18rpx; padding-top:20rpx; border-top:1rpx solid #e8ecdf; }
.classroom-heading { display:flex; align-items:center; gap:14rpx; font-size:25rpx; color:#748a5a; }
.classroom-badge { background:#f1f3e8; color:#a4ae90; font-size:17rpx; padding:5rpx 10rpx; border:1rpx solid #e5e9da; border-radius:7rpx; }
.classroom-note { color:#a7ae99; font-size:19rpx; line-height:1.7; margin:12rpx 0 22rpx; }
.classroom-review { display:flex; align-items:flex-start; gap:17rpx; padding:24rpx 0; border-bottom:1rpx solid #edf0e6; }
.classroom-avatar { flex-shrink:0; width:61rpx; height:61rpx; display:flex; align-items:center; justify-content:center; border-radius:18rpx; color:#7d9364; background:#ecf1e3; font-size:25rpx; border:1rpx solid #dee7d1; }
.classroom-avatar.avatar-1 { color:#af9360; background:#f6f0df; border-color:#ebe0c3; }
.classroom-avatar.avatar-2 { color:#829b8e; background:#eaf1ed; border-color:#dce8e0; }
.classroom-review-copy { flex:1; min-width:0; }
.classroom-review-top { display:flex; align-items:center; justify-content:space-between; gap:12rpx; color:#718657; font-size:23rpx; line-height:1.6; }
.classroom-stars { color:#bfa15f; font-size:20rpx; flex-shrink:0; letter-spacing:1rpx; }
.classroom-comment { color:#7e8b6e; font-size:24rpx; line-height:1.9; margin-top:13rpx; word-break:break-all; }
.classroom-date { color:#b1b7a4; font-size:19rpx; margin-top:12rpx; }
.page button.more-classroom { width:100%; margin:20rpx 0 0; padding:14rpx; background:#f1f4e9; color:#8a9d70; font-size:22rpx; line-height:1.8; border-radius:12rpx; }
