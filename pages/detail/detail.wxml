<view class="page detail-page">
 <view wx:if="{{error}}" class="notice error">{{error}}<button class="secondary" bindtap="refresh" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">重新读取</button></view>
 <block wx:if="{{item}}">
  <text class="pill">{{schoolName}} · {{item.category}}</text><view class="detail-title">{{item.title}}</view>
  <view class="author-card"><image wx:if="{{item.isLocal}}" src="/assets/icon.png"/><view wx:else class="author-mark">{{authorName[0]}}</view><view class="author-copy"><view>{{authorName}}{{authorDemo ? ' · 示例同学' : ' · 我发布的'}}</view><text>{{section === 'resources' ? item.course + ' · ' + item.major : '同校闲置 · 当面交接'}}</text></view><button class="credit-badge" bindtap="openCredit" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">信用 {{authorCredit}} ▸</button></view>
  <block wx:if="{{section === 'resources'}}">
   <view class="rating-summary"><view class="rating-summary-left"><view class="rating-large">{{score}}<text>/ 5</text></view><view class="rating-stars"><text>★★★★★</text><text class="rating-stars-fill" style="width:{{scorePercent}}%">★★★★★</text></view></view><view class="rating-summary-copy"><view>{{scoreSource}}</view><text>{{reviewCount ? reviewCount + ' 条本机使用反馈' : classroomCount ? classroomCount + ' 条课堂点评可供参考' : '期待第一份使用反馈'}}</text><text class="rating-hint">读过、练过，再留下你的评价</text></view><view class="rating-decoration">✦</view></view>
   <view wx:if="{{goldReason}}" id="gold" class="gold-panel"><view class="gold-heading"><text>✦ 平台金选</text><text class="small-label">内容推荐 · 独立于同学评分</text></view><view>{{goldReason}}</view><button class="text-link" bindtap="toggleGold" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{goldOpen ? '收起标准 ▴' : '了解入选标准 ▾'}}</button><block wx:if="{{goldOpen}}"><view wx:for="{{goldCriteria}}" wx:key="*this" class="gold-criterion">✓ {{item}}</view><view class="small-label">基于原创演示正文的编辑推荐，不代表学校认证；标签不改变账号信用或同学评分。</view></block></view>
   <view class="description">{{item.description}}</view>
   <view wx:if="{{item.attachment}}" class="attachment"><view><text class="attachment-format">{{item.attachment.type}}</text><view class="attachment-name">{{item.attachment.name}}</view><text class="small-label">本机文件 · 微信文件预览</text></view><button class="secondary" bindtap="openAttachment" loading="{{exporting}}" disabled="{{exporting}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">打开文件</button></view>
   <view class="reading-actions"><button class="secondary" wx:if="{{item.body}}" bindtap="copyBody" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">复制正文</button><button class="secondary" wx:if="{{item.body}}" bindtap="exportText" loading="{{exporting}}" disabled="{{exporting}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">导出 TXT</button><button class="download-stats" bindtap="showDownloadStats" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{downloadsDemo ? '示例下载 / 导出' : '本机下载 / 导出'}} {{downloads}} 次 ⓘ</button></view>
   <view wx:if="{{item.body}}" class="reader-tools"><view>静心读一会<text>约 {{readingMinutes}} 分钟 · 字号可调</text></view><view class="font-controls"><button class="font-button" data-direction="-1" bindtap="changeFont" disabled="{{readerFont === 26}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">A−</button><text>{{readerFont}}</text><button class="font-button" data-direction="1" bindtap="changeFont" disabled="{{readerFont === 36}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">A+</button></view></view>
   <view wx:if="{{item.body}}" class="reading" style="font-size:{{readerFont}}rpx"><text selectable="{{true}}">{{item.body}}</text></view>
   <view wx:if="{{nextResource}}" class="next-panel" data-id="{{nextResource.id}}" bindtap="openRelated" hover-class="surface-pressed" hover-start-time="0" hover-stay-time="80"><text class="small-label">接着这条学习路线</text><view>{{nextResource.title}} →</view></view>
   <view id="reviews" class="panel reviews"><view class="panel-heading">同学怎么说 <text>{{reviewCount ? reviewCount + ' 条我的反馈' : classroomCount + ' 条课堂点评'}}</text></view><view class="distribution-caption">{{distributionNote}}</view><view class="distribution"><view wx:for="{{distribution}}" wx:key="score" class="distribution-row"><text>{{item.score}} 星</text><view class="distribution-track"><view style="width:{{item.width}}%"/></view><text>{{item.count}}</text></view></view>
    <view wx:for="{{reviews}}" wx:key="id" class="review"><view class="review-top">{{item.author}} · 我<text>{{item.starsText}}</text></view><view class="review-comment">{{item.comment}}</view><view class="small-label">{{item.date}}</view></view>
    <view wx:if="{{classroomCount}}" class="classroom-section"><view class="classroom-heading"><text>课后讨论室</text><text class="classroom-badge">课堂示例</text></view><view class="classroom-note">以下为演示预置点评，不计入你提交的评价均分。</view><view wx:for="{{classroomReviews}}" wx:key="id" class="classroom-review"><view class="classroom-avatar avatar-{{index % 3}}">{{item.author[0]}}</view><view class="classroom-review-copy"><view class="classroom-review-top"><text>{{item.author}}</text><text class="classroom-stars">{{item.starsText}}</text></view><view class="classroom-comment">{{item.comment}}</view><view class="classroom-date">{{item.date}}</view></view></view><button wx:if="{{hasMoreClassroom}}" class="more-classroom" bindtap="moreClassroomReviews" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">再看看同学的点评 ↓</button></view>
    <view wx:if="{{canReview}}" class="review-form"><view class="form-label">{{mine ? '修改我的评价' : '用过之后，留一点反馈'}}</view><view class="stars"><button wx:for="{{stars}}" wx:key="*this" class="star {{reviewScore >= item ? 'selected' : ''}}" data-value="{{item}}" bindtap="selectStar" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">★</button><text>{{reviewScore || '请选'}} / 5</text></view><textarea value="{{reviewComment}}" bindinput="inputReview" placeholder="哪一部分有帮助？还有哪里需要补充？（5—240字）" maxlength="240" auto-height /><view class="form-actions"><button class="primary" bindtap="submitReview" loading="{{saving}}" disabled="{{saving}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{mine ? '保存修改' : '提交评价'}}</button><button wx:if="{{mine}}" class="text-link" bindtap="deleteReview" disabled="{{saving}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">删除我的评价</button></view></view><view wx:else class="small-label">这是你上传的资料，不能给自己的内容评分。</view>
   </view>
  </block>
  <block wx:else>
   <swiper wx:if="{{photos.length}}" class="gallery" indicator-dots="{{photos.length > 1}}" indicator-color="#d8dfd3" indicator-active-color="#3c6752"><swiper-item wx:for="{{photos}}" wx:key="*this"><image src="{{item}}" mode="aspectFit" data-src="{{item}}" bindtap="previewPhoto"/></swiper-item></swiper><view wx:else class="photo-empty">发布者暂未提供照片</view><view class="photo-label">{{item.isLocal ? '本机发布照片 · 点击可查看' : '同类实物参考图 · 课堂案例'}}</view>
   <view class="price">¥{{auction ? bidPrice : price}}<text>{{auction ? (auction.bid_count ? (auction.ended ? '最终出价' : '当前价') : '起拍价') : '当面交易'}} · {{item.condition}}</text></view><view class="place">交接地点 · {{item.place}}</view>
   <view wx:if="{{auction}}" class="panel auction-panel"><view class="panel-heading">校园竞价 <text>{{remaining}}</text></view><view class="small-label">截止 {{endLabel}} · 每次加价 ¥{{increment}}</view><view class="bid-stats"><view><text>起拍价</text><view>¥{{price}}</view></view><view><text>出价记录</text><view>{{auction.bid_count}} 次</view></view></view>
    <view class="auction-status-card {{auctionTone}}"><view><text class="auction-status-dot">●</text>{{auctionStatus}}</view><text wx:if="{{hasMyBid}}">我的最高出价 ¥{{myBidPrice}} · {{auction.myBidCount}} 次出价</text><text wx:else>{{auction.isOwner ? '记录与你发布的物品关联' : '先确认物品与交接地点，再参与竞价'}}</text></view>
    <view wx:if="{{!auction.ended && !auction.isOwner}}" class="bid-form"><view class="small-label">本次至少 ¥{{nextBid}}；每档加价 ¥{{increment}}。</view><view class="bid-quick-actions"><button class="bid-step" data-mode="minimum" bindtap="adjustBid" disabled="{{saving || confirming}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">使用最低金额</button><button class="bid-step" data-mode="increase" bindtap="adjustBid" disabled="{{saving || confirming}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">+ 一档 ¥{{increment}}</button></view><view class="inline-form"><input type="digit" value="{{bidAmount}}" bindinput="inputBid" maxlength="12" disabled="{{saving || confirming}}"/><button class="primary" bindtap="submitBid" loading="{{saving}}" disabled="{{saving || confirming || credit.score < 60}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">确认出价</button></view><view wx:if="{{credit.score < 60}}" class="form-error">当前信用暂停新出价，已有竞拍和预约仍可查看。</view><view wx:if="{{bidHint}}" class="form-error">{{bidHint}}</view></view><view wx:elif="{{auction.isOwner}}" class="small-label">这是你发布的拍卖，不能给自己出价。</view><view wx:else class="auction-result">{{auction.isWinner ? '你是最高出价者，可以查看或预约见面' : auction.bid_count ? '拍卖已结束，仅最高出价者可预约' : '拍卖已结束，暂时没有出价'}}</view>
    <view wx:if="{{hasMyBid}}" class="my-auction-link"><text>竞拍进展会同步到我的订单</text><button class="text-link" bindtap="openParticipations" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">查看我的竞拍 →</button></view><view wx:for="{{bids}}" wx:key="id" class="bid-row"><view>{{item.nickname}}{{item.isMine ? ' · 我' : ''}}<text>{{item.date}}</text></view><text>¥{{item.price}}</text></view><view wx:if="{{auction.bid_count > bids.length}}" class="small-label">展示最近 {{bids.length}} 次出价；我的参与统计包含完整记录。</view><view class="small-label">本机模拟，无真实竞争者与支付；预置记录已标示为示例。</view>
   </view>
   <view class="reading"><text selectable="{{true}}">{{item.description}}</text></view>
   <view class="panel checklist"><button class="panel-toggle" bindtap="toggleChecklist" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">当面验货清单 <text>{{checkedCount}} / 4 {{checklistOpen ? '▴' : '▾'}}</text></button><block wx:if="{{checklistOpen}}"><view class="small-label">按实际检查情况勾选，仅辅助检查，不代表交易担保。</view><button wx:for="{{checklist}}" wx:key="index" class="check-item {{checks[index] ? 'checked' : ''}}" data-index="{{index}}" bindtap="toggleCheck" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><text class="check-square">{{checks[index] ? '✓' : ''}}</text><text>{{item}}</text></button><view wx:if="{{checkedCount === 4}}" class="check-done">本次清单已勾选完成，请以实物检查为准。</view></block></view>
   <view class="credit-note">我的信用 {{credit.score}} · {{credit.level}}<text>待见面预约 {{credit.activeCount}} / {{credit.limit}}</text></view>
   <view wx:if="{{order && order.status !== 'cancelled'}}" class="panel"><view class="panel-heading">{{order.status === 'reserved' ? '这件物品已预约' : order.status === 'completed' ? '这件物品已完成模拟交接' : '这件物品有爽约记录'}}</view><button class="secondary" bindtap="openOrders" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">查看我的订单</button></view>
   <button wx:elif="{{!item.isLocal && (!auction || auction.isWinner)}}" class="primary reserve-open" bindtap="showReservation" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{reservationOpen ? '收起预约 ▴' : order ? '重新预约见面' : '预约见面 · 模拟下单'}}</button>
   <view wx:if="{{reservationOpen}}" class="panel reservation"><view class="panel-heading">约个时间，当面看看</view><view class="small-label">仅允许未来 15 天；取消与爽约会按规则影响本机信用。</view><view class="form-row"><picker mode="date" value="{{meetingDate}}" start="{{minDate}}" end="{{maxDate}}" data-field="meetingDate" bindchange="reservationInput"><view class="form-picker">{{meetingDate}} ▾</view></picker><picker mode="time" value="{{meetingTime}}" data-field="meetingTime" bindchange="reservationInput"><view class="form-picker">{{meetingTime}} ▾</view></picker></view><input class="field" value="{{meetingPlace}}" maxlength="80" data-field="meetingPlace" bindinput="reservationInput" placeholder="公共交接地点"/><textarea class="field" value="{{meetingNote}}" maxlength="240" data-field="meetingNote" bindinput="reservationInput" placeholder="补充说明（选填）" auto-height/><view wx:if="{{reservationHint}}" class="form-error">{{reservationHint}}</view><button class="primary" bindtap="submitReservation" loading="{{saving}}" disabled="{{saving || confirming}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">确认模拟预约</button></view>
  </block>
  <view class="notice" wx:if="{{hint}}">{{hint}}</view>
  <view class="related" wx:if="{{related.length}}"><view class="panel-heading">{{section === 'resources' ? '同课程，接着看看' : '同类闲置，比较一下'}}</view><button wx:for="{{related}}" wx:key="id" class="related-item" data-id="{{item.id}}" bindtap="openRelated" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><text class="related-title">{{item.title}}</text><text class="related-arrow">›</text></button></view>
  <view class="footnote">课堂案例 · 原创演示内容与本机记录无真实学籍核验、真人聊天或付款</view>
  <view class="detail-bar"><button class="bar-save {{favorite ? 'saved' : ''}}" bindtap="toggleFavorite" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80"><image class="heart-icon" src="{{favorite ? '/assets/nav/heart-filled.png' : '/assets/nav/heart-outline.png'}}" mode="aspectFit" /><text>{{favorite ? '已收藏' : '收藏'}}</text></button><button wx:if="{{section === 'resources'}}" class="bar-primary" bindtap="{{item.attachment ? 'openAttachment' : 'exportText'}}" disabled="{{exporting}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">{{item.attachment ? '打开资料' : '导出资料'}}</button><button wx:else class="bar-primary" bindtap="startChat" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="80">联系卖家</button></view>
 </block>
</view>
