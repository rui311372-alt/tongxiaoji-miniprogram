.messages-page{padding-bottom:28rpx}.heading{display:flex;align-items:center;justify-content:space-between;margin:8rpx 0 20rpx}.school-name{color:#6e7f70;font-size:24rpx}.notice{font-size:24rpx;color:#7b8575;line-height:1.8;margin-bottom:30rpx}.empty-card{background:#fffefa;border:1rpx solid #e0e5d6;border-radius:24rpx;padding:60rpx 34rpx;text-align:center;margin-top:40rpx}.bubble-icon{display:inline-block;background:#e8efdf;color:#497056;border-radius:24rpx;padding:22rpx;font-size:36rpx;font-weight:700}.empty-title{font-size:32rpx;font-weight:700;margin:30rpx 0 16rpx}.empty-text{font-size:26rpx;line-height:1.9;color:#7b8575}.empty-card button{background:#33654f;color:white;margin-top:34rpx;width:80%;padding:12rpx}.thread-list{border:1rpx solid #e0e5d6;border-radius:24rpx;overflow:hidden;background:#fffefa}.thread{display:flex;align-items:center;padding:28rpx 22rpx;border-bottom:1rpx solid #ecede3;gap:18rpx;width:100%;border-radius:0;text-align:left;margin:0;background:transparent;line-height:1.5;color:#253d32}.thread:last-child{border:0}.thread-avatar{background:#e8efdf;width:90rpx;height:90rpx;line-height:90rpx;text-align:center;border-radius:17rpx;font-weight:700;color:#577456;font-size:30rpx;flex-shrink:0}.thread-content{min-width:0;flex:1}.thread-head{display:flex;align-items:center;gap:12rpx}.thread-title{font-weight:600;font-size:27rpx;flex:1;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.thread-head>text{color:#8a9385;font-size:19rpx;flex-shrink:0}.last-message{font-size:24rpx;color:#77816f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:8rpx}.conversation-school{font-size:21rpx;color:#8a9383;margin-top:7rpx}.arrow{color:#88947d;font-size:35rpx}.error{padding:30rpx;color:#a13e27;line-height:1.7}.error button{margin-top:20rpx;color:#33654f;background:#e9efdf}
