<view class="page messages-page">
  <view class="heading"><view class="section-title">校园消息</view><button hover-class="ui-press" class="manage-toggle" bindtap="toggleManage" disabled="{{busy || !threads.length || !!error}}" hover-start-time="0" hover-stay-time="140">{{managing?'完成':'管理'}}</button></view>
  <view wx:if="{{managing}}" class="conversation-tools"><text class="manage-hint">删除后无法恢复</text><button hover-class="ui-press" class="clear-threads" bindtap="clearThreads" disabled="{{busy}}" hover-start-time="0" hover-stay-time="140">清空本校</button></view>
  <view wx:if="{{actionError}}" class="action-error" role="alert">{{actionError}}</view>
  <view wx:if="{{error}}" class="error">{{error}}<button hover-class="ui-press" bindtap="refresh" hover-start-time="0" hover-stay-time="140">重新读取</button></view>
  <view wx:elif="{{!threads.length}}" class="empty-card"><view class="empty-mascot"><image src="/assets/mascot-wave.png" mode="scaleToFill" aria-hidden="true" /></view><view class="empty-title">还没有会话</view><view class="empty-text">看中同校好物？<view>在物品详情联系卖家，体验模拟沟通。</view></view><button hover-class="ui-press" bindtap="goMarket" hover-start-time="0" hover-stay-time="140">去二手集市看看 <text>→</text></button></view>
  <view wx:else class="thread-list">
    <view wx:for="{{threads}}" wx:key="id" class="thread-row {{managing?'thread-row-managing':''}}">
    <button class="thread" hover-class="{{managing?'none':'thread-pressed'}}" data-id="{{item.id}}" bindtap="open" bindlongpress="deleteThread" disabled="{{busy}}" hover-start-time="0" hover-stay-time="140">
      <image wx:if="{{item.photo}}" class="thread-avatar" src="{{item.photo}}" mode="aspectFill" data-id="{{item.id}}" binderror="photoError"/>
      <view wx:else class="thread-avatar placeholder">物</view>
      <view class="thread-content">
        <view class="thread-head"><view class="thread-title">{{item.title}}</view><text wx:if="{{item.time && !managing}}" class="thread-time">{{item.time}}</text></view>
        <view class="last-message">{{item.last}}</view>
      </view>
      <text wx:if="{{!managing}}" class="arrow">›</text>
    </button>
    <button hover-class="ui-press" wx:if="{{managing}}" class="thread-delete" data-id="{{item.id}}" bindtap="deleteThread" disabled="{{busy}}" aria-label="删除与{{item.title}}有关的会话" hover-start-time="0" hover-stay-time="140">删除</button>
    </view>
  </view>
</view>
<campus-nav active="messages" bind:select="onMainNav"/>
