<view class="entry-shell">
  <view class="entry-header"><view class="entry-brand"><image src="/assets/icon.png" mode="aspectFit" /><text>同校集</text></view><text class="header-caption">同校分享 · 刚好需要</text></view>
  <view class="entry-main">
    <view class="entry-intro">
      <view class="intro-copy"><view class="intro-eyebrow"><view class="intro-dot"/>你的校园日常</view><view class="entry-title">好资料，好物品。<view class="entry-title-accent">都在同校集。</view></view><view class="entry-subtitle">让学习有帮手，<view>让闲置有去处。</view></view></view>
      <view class="mascot-scene" bindtap="greet" hover-class="mascot-pressed" hover-start-time="0" hover-stay-time="100" aria-role="button" aria-label="和小集打个招呼"><view class="wave-viewport"><image class="wave-sprite {{waving ? 'is-waving' : ''}}" src="/assets/mascot-wave.png" mode="scaleToFill" /></view><text wx:if="{{greeting}}" class="mascot-bubble">{{greeting}}</text></view>
    </view>
    <picker mode="selector" range="{{schools}}" range-key="name" value="{{schoolIndex}}" bindchange="onSchoolChange" disabled="{{navigating}}"><view class="school-choice" hover-class="school-pressed" hover-start-time="0" hover-stay-time="100"><view class="school-copy"><text class="school-label">当前校园</text><text class="school-name">{{school.name}}</text></view><text class="school-arrow">切换 <text>⌄</text></text></view></picker>
    <view wx:if="{{schoolHint}}" class="school-hint">{{schoolHint}}</view>
    <view class="entry-destinations">
      <button class="entry-destination resource-entry" hover-class="entry-pressed" hover-start-time="0" hover-stay-time="100" data-section="resources" bindtap="openSection" disabled="{{navigating}}"><view class="entry-dest-icon"><image src="/assets/nav/library-white.png" mode="aspectFit" /></view><view class="entry-dest-copy"><view class="entry-dest-title">学习资料</view><view class="entry-dest-note">课程笔记 · 期末复习 · 同学互助</view></view><text class="entry-arrow">↗</text></button>
      <button class="entry-destination market-entry" hover-class="entry-pressed" hover-start-time="0" hover-stay-time="100" data-section="market" bindtap="openSection" disabled="{{navigating}}"><view class="entry-dest-icon"><image src="/assets/nav/market-active.png" mode="aspectFit" /></view><view class="entry-dest-copy"><view class="entry-dest-title">校园集市</view><view class="entry-dest-note">发现同校闲置，让好物继续发光</view></view><text class="entry-arrow">↗</text></button>
    </view>
    <view class="campus-ad" aria-label="预留广告位，小集举牌：广告出租">
      <text class="ad-badge">广告</text>
      <image class="ad-mascot" src="/assets/mascot-ad.png" mode="aspectFit" aria-label="吉祥物举着写有广告出租的牌子" />
      <view class="ad-copy"><view class="ad-eyebrow">校园合作</view><view class="ad-title">好消息，<view>留个位置。</view></view><view class="ad-note">校园合作展示位 · 预留</view></view>
    </view>
    <button class="guide-link" bindtap="showGuides" hover-class="ui-press" hover-start-time="0" hover-stay-time="100">ⓘ 第一次来？看看使用指南</button>
  </view>
  <view class="entry-bottom">课程演示 · 认证与交易均为模拟体验</view>
</view>
