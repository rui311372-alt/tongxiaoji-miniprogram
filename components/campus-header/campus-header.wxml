<view class="campus-header">
  <view class="campus-header__brand" bindtap="returnHome"><image src="/assets/icon.png" mode="aspectFit" /><view><view class="campus-header__name">同校集</view><view class="campus-header__tagline">同校分享，刚好需要</view></view></view>
  <picker class="campus-header__picker" range="{{schools}}" range-key="name" value="{{index}}" bindchange="chooseSchool" disabled="{{disabled}}"><view class="campus-header__school">{{school.name}}<text>⌄</text></view></picker>
</view>
<view class="campus-context"><view class="campus-context__dot" /><text>{{school.name}}</text></view>
