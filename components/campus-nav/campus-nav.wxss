/* The same five destinations as the mobile web app. */
:host { display: block; }
.campus-nav-space {
  height: 76px;
  height: calc(76px + constant(safe-area-inset-bottom));
  height: calc(76px + env(safe-area-inset-bottom));
  pointer-events: none;
}
.campus-nav {
  position: fixed;
  z-index: 80;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #fffefa;
  border-top: 1px solid #e5e9de;
  box-shadow: 0 -3px 16px rgba(41, 67, 35, 0.035);
}
.campus-nav .campus-nav__row {
  display: flex;
  align-items: center;
  height: 76px;
  padding: 5px 10px 7px;
  box-sizing: border-box;
}
/* Explicit width/margins override native style:v2 button defaults. */
.campus-nav .campus-nav__button {
  display: flex !important;
  flex: 1 1 0 !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0 !important;
  max-width: none !important;
  width: auto !important;
  height: 60px !important;
  margin: 0 1px !important;
  padding: 4px 2px !important;
  border: 0;
  border-radius: 14px;
  background: transparent !important;
  color: #687662;
  box-sizing: border-box;
  box-shadow: none;
  font-size: 13px;
  font-weight: 400;
  line-height: 17px;
  transition: transform 140ms cubic-bezier(.23,1,.32,1),opacity 140ms cubic-bezier(.23,1,.32,1);
}
.campus-nav .campus-nav__button::after { border: 0; }
.campus-nav .campus-nav__button.is-active {
  color: #28583f;
  font-weight: 600;
  background: #edf3e9 !important;
}
.campus-nav .campus-nav__button.is-disabled { opacity: 0.6; }
.campus-nav .campus-nav__button.campus-nav__pressed { transform:scale(.97); opacity:.9; }
.campus-nav__icon { display: block; width: 22px; height: 22px; margin-bottom: 5px; flex-shrink: 0; }
.campus-nav__label { display: block; white-space: nowrap; }
.campus-nav .campus-nav__publish {
  flex: 0 0 61px !important;
  align-self: center;
  overflow: visible;
  margin: -2px 4px 0 !important;
  color: #2c654c;
}
.campus-nav__publish .campus-nav__label { margin-top: 0; }
.campus-nav__plus {
  position: relative;
  width: 29px;
  height: 29px;
  flex-shrink: 0;
  border-radius: 9px;
  background: #2c654c;
  box-shadow: 0 2px 6px rgba(23, 105, 79, 0.13);
}
.campus-nav__plus-line {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 1px;
  background: #fff;
  transform: translate(-50%, -50%);
}
.campus-nav__plus-horizontal { width: 16px; height: 2px; }
.campus-nav__plus-vertical { width: 2px; height: 16px; }
@media (prefers-reduced-motion: reduce) {
  .campus-nav .campus-nav__button { transition:opacity 100ms ease-out; }
  .campus-nav .campus-nav__button.campus-nav__pressed { transform:none; }
}
